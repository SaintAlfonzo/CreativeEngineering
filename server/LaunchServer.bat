@ECHO OFF
setlocal enabledelayedexpansion

:: When setting the memory below make sure to include the amount of ram letter. M = MB, G = GB. Don't use 1GB for example, it's 1G

:: This is the max memory
set maxmemory=6G

:: The path to the Java to use. Use "java" to point to system default install.
set javapath="java"

:: Any additional arguments to pass to Java such as Metaspace, GC or anything else
set jvmargs="-XX:FlightRecorderOptions=stackdepth=256,repository=perf/jfr-repo -XX:StartFlightRecording=name=ce,settings=perf/ce-server.jfc,disk=true,maxage=30m,maxsize=512m,dumponexit=true,filename=perf/exit"
:: ^ always-on performance recording (Java Flight Recorder): keeps the last 30 minutes (at most 512 MB) in
::   perf\jfr-repo\. Save it with perf\dump.bat when the server lags; see perf\README.md. Remove the two
::   -XX options to turn it off. stackdepth=256: the default 64 cuts deep modded stacks. dumponexit: every
::   stop, watchdog crashes included, writes the last 30 minutes to perf\exit\ (the newest 3 are kept).

::----------------------------::
:: Don't edit past this point ::
::----------------------------::

set launchargs=%*

:: perf\exit must exist, or JFR writes a file named "exit"; keep its newest 3 recordings
if not exist "%~dp0perf\exit" mkdir "%~dp0perf\exit"
for /f "skip=3 delims=" %%f in ('dir /b /o-d "%~dp0perf\exit\*.jfr" 2^>nul') do del "%~dp0perf\exit\%%f"
:: Launcher can specify path to java using a custom token
IF "%1"=="ATLcustomjava" (
    echo Using launcher provided Java from %2
    SET javapath="%2"

    :: Set launchargs to %3 and onwards
    call set launchargs=%%launchargs:*%2=%%
)

:: Remove all double quotes from jvmargs
set "jvmargs=!jvmargs:"=!"

:: Remove all existing double quotes from javapath
set "javapath=!javapath:"=!"

:: Add one set of double quotes around javapath
set "javapath="!javapath!""

echo.
echo Printing Java info below, if the Java version doesn't show below, your Java path is incorrect
echo -----------------------
echo Java path is %javapath%
%javapath% -version
echo.

set finaljavaargs=-Xmx%maxmemory% %jvmargs%  
for /l %%i in (1,1,31) do set finaljavaargs=!finaljavaargs:  = !

IF EXIST "%~dp0server.jar" (
    echo Using NeoForge ServerStarterJar, resetting user_jvm_args.txt contents
    echo.

    echo # DO NOT EDIT THIS FILE, IT IS AUTO GENERATED BY LaunchServer.bat/sh>"%~dp0user_jvm_args.txt"
    echo # TO MAKE CHANGES TO RAM OR JVM ARGUMENTS, EDIT LaunchServer.bat/sh>>"%~dp0user_jvm_args.txt"
    echo %finaljavaargs%>>"%~dp0user_jvm_args.txt"

    REM Keep finaljavaargs on the command line: the starter jar runs the server in this same JVM and drops
    REM -X options from the args files, so clearing it here launched the server without -Xmx or any
    REM other JVM option at all.
)

echo Launching below command
echo -----------------------
echo %javapath% %finaljavaargs% -jar server.jar %launchargs%
echo.
%javapath% %finaljavaargs% -jar server.jar %launchargs%
PAUSE

