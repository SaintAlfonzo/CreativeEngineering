do {"click_widget": {"class": "PageFlipButton", "n": 1}}
do {"wait": 5}
shot hardest_p3
do {"click_widget": {"class": "PageFlipButton", "n": 1}}
do {"wait": 5}
shot hardest_p4
do {"screen": "close"}
cli:shell python3 "$INST/tools/scratch_query/qrun.py" toml config/solraspberrypie-client.toml foodDictionary uneatenSort '"EASIEST"'
cli:waitlog \[creativecommon\] solraspberrypie-client\.toml reloaded 20
