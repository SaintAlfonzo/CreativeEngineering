waitlog \[cdevtest\] verb=pbot\.useitem bot=rps7 end=finish item=minecraft:bread 30
> pbot hunger rps7 2
> pbot inv rps7 set 0 minecraft:apple 1
> pbot inv rps7 select 0
> pbot eat rps7
waitlog \[cdevtest\] verb=pbot\.useitem bot=rps7 end=finish item=minecraft:apple 30
> pbot hunger rps7 2
> pbot inv rps7 set 0 minecraft:cooked_beef 1
> pbot inv rps7 select 0
> pbot eat rps7
waitlog \[cdevtest\] verb=pbot\.useitem bot=rps7 end=finish item=minecraft:cooked_beef 30
> pbot hunger rps7 2
> pbot inv rps7 set 0 minecraft:baked_potato 1
> pbot inv rps7 select 0
> pbot eat rps7
waitlog \[cdevtest\] verb=pbot\.useitem bot=rps7 end=finish item=minecraft:baked_potato 30
> pbot hunger rps7 2
> pbot inv rps7 set 0 minecraft:carrot 1
> pbot inv rps7 select 0
> pbot eat rps7
waitlog \[cdevtest\] verb=pbot\.useitem bot=rps7 end=finish item=minecraft:carrot 30
