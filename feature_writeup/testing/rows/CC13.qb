do {"tooltip_text": "minecraft:packed_ice", "expect": ": Saltable$"}
do {"tooltip_text": "minecraft:snow", "expect": ": Saltable$"}
do {"tooltip_text": "minecraft:snow_block", "expect": ": Saltable$"}
