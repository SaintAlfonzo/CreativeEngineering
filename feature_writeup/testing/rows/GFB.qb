@fails Cache not cleared on TagsUpdatedEvent
@reviewed 2026-11-16
> cdevtest season minecraft:plains
shell L=$(grep -m1 '^level-name=' server.properties | cut -d= -f2); d="$L/datapacks/stc02"; mkdir -p "$d/data/creativecalendar/tags/worldgen/biome/seasons"; printf '{"pack":{"pack_format":10,"description":"SQ-STC-02"}}' > "$d/pack.mcmeta"; printf '{"replace":false,"values":["minecraft:plains"]}' > "$d/data/creativecalendar/tags/worldgen/biome/seasons/arid.json"; ls -R "$d" | head
> reload
sleep 20
> datapack list enabled
> cdevtest season minecraft:plains
