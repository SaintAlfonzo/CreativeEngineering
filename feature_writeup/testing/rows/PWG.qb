waitlog \[zpwg3\] done 20
> zpwg3 place 1101 -60 2100 powergrid:wire_connector facing=west
> zpwg3 src 1104 -60 2100 12
> zpwg3 place 1104 -60 2103 powergrid:voltage_gauge
> zpwg3 w 1104 -60 2100 0 1101 -60 2100 0
> zpwg3 w 1101 -60 2100 0 1104 -60 2103 0
> zpwg3 w 1104 -60 2100 1 1104 -60 2103 1
sleep 1
> zpwg3 be 1104 -60 2103
> zpwg3 be 1101 -60 2100
> zpwg3 place 1101 -59 2100 minecraft:stone
sleep 0.5
> zpwg3 be 1101 -60 2100
> setblock 1100 -60 2100 air
sleep 0.5
> zpwg3 be 1101 -60 2100
> zpwg3 count 1101 -60 2100 3 powergrid:wire_connector
> zpwg3 count 1101 -60 2100 6 powergrid:wire
> zpwg3 be 1104 -60 2103
> zpwg3 place 1100 -60 2106 minecraft:stone
> zpwg3 place 1100 -59 2106 powergrid:heavy_wire_connector facing=down
> zpwg3 src 1104 -60 2106 12
> zpwg3 w 1104 -60 2106 0 1100 -59 2106 0
sleep 1
> zpwg3 be 1100 -59 2106
