shell ! grep -n "patcherMod" logs/latest.log
shell ! grep -hnE "^\s*#.*\b(colour|centre|behaviour|neighbour)" config/creativecommon-common.toml config/creativecompat-common.toml config/creativedelight-common.toml config/creativeworldgen-common.toml config/creativeequipment-common.toml config/creativelabels-common.toml
shell grep -q "neighbours = " config/creativecompat-common.toml
> reload
shell ! grep -n "patcherMod" logs/latest.log
look the config comments read naturally (no "Creative Common Creative Common" or broken sentence where a date or old name was taken out)

