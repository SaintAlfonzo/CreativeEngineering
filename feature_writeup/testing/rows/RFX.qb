do {"tooltip_text": "creativeengineering:precision_sawblade", "expect": "Unprogrammed"}
do {"tooltip_text": "canned_goods:canned_food", "expect": "REMOVED ITEM"}
do {"tooltip_text": "dragonloot:dragon_helmet", "expect": "When worn"}
do {"tooltip_text": "creativeequipment:echo_pickaxe", "expect": "On hit"}
