> gamerule doMobSpawning false
> gamerule doDaylightCycle false
> forceload add 0 0 63 31
> forceload add 608 512 639 527
> forceload add 192 192 223 207
sleep 10
> nsmfix chests
> nsmfix placed
> nsmfix ground
> nsmfix bags
> nsmfix bots
sleep 3
> nsmfix gear
> nsmfix labels
> nsmfix label
> nsmfix potjar
> nsmfix dims
sleep 5
> nsmfix logout
> nsmfix manifest
waitlog \[nsmfix\] OK step manifest finished 60
expect \[nsmfix\] OK step gear finished
expect \[nsmfix\] OK step labels finished
expect \[nsmfix\] OK step dims finished
> fill 60 -60 0 62 -58 0 minecraft:stone
> summon immersive_paintings:painting 60 -59 1 {Motive:"creativeengineering:paintings/minecraft/alban.png",Facing:0b}
