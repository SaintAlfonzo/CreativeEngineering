@fails rows are `values(..., { when })` in the jar startup scripts
@jars creativecommon creativedelight
@from batches/r1102b/s2_A.qb
> dumpcompost
sleep 5
shell python3 -I -c "import json,collections;n=json.load(open('kubejs/exported/compost/compost.json'))['now'];c=collections.Counter((k.split(':')[0],v.get('source')) for k,v in n.items() if k.split(':')[0] in ('farmersdelight','fungidelight','veggiesdelight','vintagedelight'));print(sorted(c.items()))"
shell python3 -I -c "import json,sys;n=json.load(open('kubejs/exported/compost/compost.json'))['now'];v=[k for k,x in n.items() if k.split(':')[0] in ('farmersdelight','fungidelight','veggiesdelight','vintagedelight') and x.get('source')=='value'];print(len(v));sys.exit(len(v)<101)"
