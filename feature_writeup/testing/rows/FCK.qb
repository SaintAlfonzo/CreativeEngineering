> cdevtest count {PL1-72} -64 {PL3} {PL1+71} 70 {PL3+11} minecraft:glow_lichen
> cdevtest count {PL1-72} -64 {PL3+12} {PL1+71} 70 {PL3+23} minecraft:glow_lichen
> cdevtest count {PL1-72} -64 {PL3+24} {PL1+71} 70 {PL3+35} minecraft:glow_lichen
> cdevtest count {PL1-72} -64 {PL3+36} {PL1+71} 70 {PL3+47} minecraft:glow_lichen
> cdevtest count {PL1-72} -64 {PL3+48} {PL1+71} 70 {PL3+59} minecraft:glow_lichen
> cdevtest count {PL1-72} -64 {PL3+60} {PL1+71} 70 {PL3+71} minecraft:glow_lichen
> say FCK07 end
waitlog FCK07 end 900
shell python3 -I -c "import re,sys;L=open('logs/latest.log',errors='replace').read().splitlines();a=sys.argv[1];i=max([k for k,l in enumerate(L) if a+' begin' in l]+[0]);t={};[t.__setitem__(m[1],t.get(m[1],0)+int(m[2])) for l in L[i:] for m in [re.search(r'verb=count block=(\S+) n=(\d+)',l)] if m];s=sum(int(m[1]) for l in L[i:] for m in [re.search(r'verb=count .*skipped_columns=(\d+)',l)] if m);print(a,'totals',t,'skipped_columns',s);z=[b for b in sys.argv[2:] if not t.get(b)];print('zero:',z);sys.exit(1 if z else 0)" FCK07
