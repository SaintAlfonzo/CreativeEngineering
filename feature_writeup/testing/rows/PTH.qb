> summon blocky_siege:projectile_fire_bomb 1016.5 -50 1060.5 {NoGravity:1b,Tags:["e21_fire_bomb"]}
> summon minecraft:spider 1018.5 -50 1060.5 {NoGravity:1b,Tags:["e21_spider"],NoAI:1b}
> summon minecraft:fox 1020.5 -50 1060.5 {NoGravity:1b,Tags:["e21_fox"],NoAI:1b}
