> setblock 1004 -60 1090 minecraft:cobweb
> fill 1008 -60 1090 1008 -58 1090 minecraft:cobweb
> fill 1012 -60 1089 1014 -58 1091 minecraft:cobweb
> summon minecraft:zombie 1000.5 -40 1090.5 {Tags:["z03p","pth"],PersistenceRequired:1b,IsBaby:0b,CanPickUpLoot:0b,Attributes:[{Name:"minecraft:generic.movement_speed",Base:0d},{Name:"minecraft:generic.max_health",Base:100d}],Health:100f}
> summon minecraft:zombie 1004.5 -40 1090.5 {Tags:["z03w","pth"],PersistenceRequired:1b,IsBaby:0b,CanPickUpLoot:0b,Attributes:[{Name:"minecraft:generic.movement_speed",Base:0d},{Name:"minecraft:generic.max_health",Base:100d}],Health:100f}
