> summon minecraft:zombie 1013.5 -40 1090.5 {Tags:["z03c","pth"],PersistenceRequired:1b,IsBaby:0b,CanPickUpLoot:0b,Attributes:[{Name:"minecraft:generic.movement_speed",Base:0d},{Name:"minecraft:generic.max_health",Base:100d}],Health:100f}
