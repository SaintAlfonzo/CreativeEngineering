> setblock 1300 -60 1300 minecraft:snow[layers=2]
> setblock 1300 -57 1300 minecraft:stone
> setblock 1300 -56 1300 minecraft:snow[layers=3]
> setblock 1303 -60 1300 minecraft:snow[layers=7]
> setblock 1303 -57 1300 minecraft:stone
> setblock 1303 -56 1300 minecraft:snow[layers=3]
> setblock 1306 -60 1300 vintagedelight:salt[layers=7]
> setblock 1306 -57 1300 minecraft:stone
> setblock 1306 -56 1300 vintagedelight:salt[layers=2]
> setblock 1309 -60 1300 twigs:bamboo_leaves[layers=3]
> setblock 1309 -57 1300 minecraft:stone
> setblock 1309 -56 1300 twigs:bamboo_leaves[layers=3]
> setblock 1312 -57 1300 minecraft:stone
> setblock 1312 -56 1300 immersiveengineering:sawdust[layers=4]
> fill 1314 -61 1299 1316 -61 1301 minecraft:water
> setblock 1315 -57 1300 minecraft:stone
> setblock 1315 -56 1300 minecraft:snow[layers=3]
sleep 1
> fill 1300 -57 1300 1315 -57 1300 minecraft:air replace minecraft:stone
sleep 4
> execute if block 1300 -60 1300 minecraft:snow[layers=5] run say ps15b13 snow 2+3 = 5
> execute if block 1303 -60 1300 minecraft:snow_block if block 1303 -59 1300 minecraft:snow[layers=2] run say ps15b13 snow 7+3 = block + 2
> execute if block 1306 -60 1300 vintagedelight:salt[layers=8] if block 1306 -59 1300 vintagedelight:salt[layers=1] run say ps15b13 salt 7+2 = 8 + 1
> cdevtest state 1309 -60 1300
> execute if block 1312 -60 1300 immersiveengineering:sawdust[layers=4] run say ps15b13 sawdust landed
