waitlog \[passthrough-timing\] side=server 60
shell python3 $INST/tools/scratch_query/qrun.py toml config/creativecompat-common.toml surface.passthrough.cobweb denseWalk 0.2
> cdevreload compat
> cdevtest tickwarp 21
waitlog verb=tickwarp end=done ticks=21 60
> zpth mod z12x
