## SQ-PS15B-12
@group A
@commands Reload test per switch (needs `/cdevreload compat`): save each with `sed -i` (rename, missed by the watcher), then run the command: `[debug.passthrough] timing` true / false, cobweb `denseWalk` 0.2, `breakStallTicks` 0, cobweb `surroundedAt` 3, layers `layerMaxSlow` 0.3, layers `solidBelowFull` 0; also one save written in place (single write) without the command
@pass each value applies after the command (timing lines start / stop, speeds change, the client gets the re-sent table: no rubber band); the in-place save applies within a few seconds without the command
@fails `CompatConfigReload.reload`, `PassValues.onConfig` re-send; night-config watcher (ENTRY_MODIFY, count 1 only)
@reviewed 2026-11-16
# every switch is saved by a whole-file rewrite (qrun.py toml), which the watcher misses, then /cdevreload compat;
# the server copy is restored at the end. Cross web at 1000 -60 1200 (3 faces: dense), zombie z12x in it
shell cp config/creativecompat-common.toml .ps15b12_compat.toml
> forceload add 990 1190 1110 1210
> setblock 1000 -60 1200 minecraft:cobweb
> setblock 999 -60 1200 minecraft:cobweb
> setblock 1001 -60 1200 minecraft:cobweb
> setblock 1000 -60 1201 minecraft:cobweb
> summon minecraft:zombie 1000.5 -60 1200.5 {Tags:["z12x","pth"],PersistenceRequired:1b,IsBaby:0b,CanPickUpLoot:0b,Attributes:[{Name:"minecraft:generic.movement_speed",Base:0d},{Name:"minecraft:generic.max_health",Base:100d}],Health:100f}
> cdevtest tickwarp 20
waitlog verb=tickwarp end=done ticks=20 60
> zpth mod z12x
shell python3 $INST/tools/scratch_query/qrun.py toml config/creativecompat-common.toml debug.passthrough timing true
> cdevreload compat
waitlog \[passthrough-timing\] side=server 60
shell python3 $INST/tools/scratch_query/qrun.py toml config/creativecompat-common.toml surface.passthrough.cobweb denseWalk 0.2
> cdevreload compat
> cdevtest tickwarp 21
waitlog verb=tickwarp end=done ticks=21 60
> zpth mod z12x
shell python3 $INST/tools/scratch_query/qrun.py toml config/creativecompat-common.toml surface.passthrough.cobweb surroundedAt 3
> cdevreload compat
> summon minecraft:zombie 1000.5 -59.6 1200.5 {Tags:["z12s","pth"],PersistenceRequired:1b,IsBaby:0b,CanPickUpLoot:0b,Attributes:[{Name:"minecraft:generic.movement_speed",Base:0d},{Name:"minecraft:generic.max_health",Base:100d}],Health:100f}
> zpth watch z12s 40 10
> cdevtest tickwarp 42
waitlog verb=tickwarp end=done ticks=42 60
shell python3 $INST/tools/scratch_query/qrun.py toml config/creativecompat-common.toml surface.passthrough breakStallTicks 0
> cdevreload compat
> pbot spawn P12 1100.5 -59 1200.5 minecraft:overworld creative
> setblock 1100 -60 1200 minecraft:snow[layers=3]
> zpth attrs P12
shell python3 $INST/tools/scratch_query/qrun.py toml config/creativecompat-common.toml surface.passthrough.layers layerMaxSlow 0.3
> cdevreload compat
> cdevtest tickwarp 22
waitlog verb=tickwarp end=done ticks=22 60
> zpth attrs P12
shell python3 $INST/tools/scratch_query/qrun.py toml config/creativecompat-common.toml surface.passthrough.layers solidBelowFull 0
> cdevreload compat
> cdevtest tickwarp 23
waitlog verb=tickwarp end=done ticks=23 60
> zpth attrs P12
shell python3 $INST/tools/scratch_query/qrun.py toml config/creativecompat-common.toml debug.passthrough timing false
> cdevreload compat
> cdevtest tickwarp 400
waitlog verb=tickwarp end=done ticks=400 120
# in-place save (one write, no rename), no command: the watcher should pick it up
shell python3 -c "p='config/creativecompat-common.toml';s=open(p).read().replace('timing = false','timing = true',1);f=open(p,'r+');f.write(s);f.truncate();f.close()"
sleep 8
> cdevtest tickwarp 401
waitlog verb=tickwarp end=done ticks=401 120
shell cp .ps15b12_compat.toml config/creativecompat-common.toml
> cdevreload compat
> pbot remove P12
> kill @e[tag=z12x]
> kill @e[tag=z12s]
> forceload remove 990 1190 1110 1210
count \[creativecompat\] creativecompat-common.toml reloaded >= 8
reject reload failed|value\(s\) corrected
reject verb=pbot\.\S+ .*error=
reject \[cdevtest\] .*done=0
