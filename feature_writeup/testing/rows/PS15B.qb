> cdevreload compat
> summon minecraft:zombie 1000.5 -59.6 1200.5 {Tags:["z12s","pth"],PersistenceRequired:1b,IsBaby:0b,CanPickUpLoot:0b,Attributes:[{Name:"minecraft:generic.movement_speed",Base:0d},{Name:"minecraft:generic.max_health",Base:100d}],Health:100f}
> zpth watch z12s 40 10
> cdevtest tickwarp 42
waitlog verb=tickwarp end=done ticks=42 60
