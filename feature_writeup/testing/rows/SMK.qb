expect verb=recipes text=storagedelight: n=(1[3-9]\d|[2-9]\d\d|\d{4,})\b
expect verb=makes item=storagedelight:acacia_drawer n=[1-9]\d*\b
expect verb=reg kind=block regex=\S+ n=1\b

## SQ-SMK-53 | a drawer places and holds items
