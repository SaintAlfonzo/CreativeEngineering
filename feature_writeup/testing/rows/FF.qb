> cdevtest food farmersdelight:hot_cocoa
> cdevtest food farmersrespite:strong_hot_cocoa
> cdevtest food farmersdelight:apple_cider
waitlog verb=food item=farmersdelight:apple_cider\S* 30
expect verb=food item=farmersdelight:hot_cocoa\S* food=true nutrition=1 modifier=0\.2
expect verb=food item=farmersrespite:strong_hot_cocoa\S* food=true nutrition=1 modifier=0\.2
expect verb=food item=farmersdelight:apple_cider\S* food=true nutrition=1 modifier=0\.2.*absorption
reject verb=\S+ .*done=0

