expect verb=rdetail id=creativedelight:baking/gingerbread_block serializer=\S+ result=create_confectionery:gingerbread_block\*1
reject verb=rdetail id=create_confectionery:gingerbread_block_recipe serializer=
expect verb=rdetail id=\S+vinegar_from_apple_jam serializer=\S+ result=vintagedelight:vinegar_jar
reject verb=\S+ .*done=0

