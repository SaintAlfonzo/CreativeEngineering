expect verb=food item=corn_delight:corn_seeds\S* food=true nutrition=1 modifier=0\.25
expect verb=food item=minecraft:pumpkin_seeds\S* food=true nutrition=1 modifier=0(\.0)?\s
expect verb=food item=vintagedelight:oat_seeds\S* food=true nutrition=1 modifier=0(\.0)?\s
expect verb=food item=vintagedelight:mixed_seeds\S* food=true nutrition=1 modifier=0(\.0)?\s
