> gamerule doFireTick false
> fill 0 100 116 4 100 116 create:fluid_pipe[creativeoxidation_stage=oxidized,creativeoxidation_waxed=false,east=true,west=true]
> setblock 2 101 116 minecraft:lightning_rod[facing=up]
> setblock 10 100 116 create:fluid_pipe[creativeoxidation_stage=oxidized,creativeoxidation_waxed=true]
