count \[zq\] creativedelight:\S*vegan_pizza\S*sequenced_assembly \{ == 1
count \[zq\] creativedelight:\S*stuffed_zucchini_boat\S*sequenced_assembly \{ == 1
count \[zq\] creativedelight:\S*stuffed_zucchinis\S*sequenced_assembly \{ == 1
expect itemtag forge:dough \(\d+\): .*veggiesdelight:sweet_potato_dough
