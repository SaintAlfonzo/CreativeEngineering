> dumpstructuregen
waitlog structuregen\.json 300
shell python3 -I $INST/tools/scratch_query/dumpq.py sset creativeengineering:group/remote +farmers_structures:aquacultures_cod +farmers_structures:cacaos +farmers_structures:fishs_stew +farmers_structures:ratatouilles +farmers_structures:shepherd_farms +farmers_structures:squids -farmers_structures:aquacultures_carp
