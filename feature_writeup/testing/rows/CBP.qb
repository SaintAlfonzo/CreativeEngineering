shell grep -h "\[NCH\] removed" logs/kubejs/*.log | cut -c1-600
shell n=$(cat logs/kubejs/startup.log logs/kubejs/server.log | grep -c "failed and was skipped"); echo "failures=$n"; test "$n" -lt 40

