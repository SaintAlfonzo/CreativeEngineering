> setblock 602 -60 521 hearthandharvest:hops_vine[north=true,age=0]
> zmelt w hop03 overworld 602 -60 521
> zmelt light overworld 602 -59 521
> gamerule randomTickSpeed 3000
sleep 10
> gamerule randomTickSpeed 3
> execute if block 602 -60 521 hearthandharvest:hops_vine[age=3] run say HOP03-age3
> zmelt show
> zmelt clear
expect HOP03-age3$
