> execute in minecraft:the_nether run summon corpse:corpse 2 64 0 {Tags:["c13b"],NoGravity:1b,Death:{PlayerName:"Test",MainInventory:[{Slot:0b,id:"minecraft:stone",Count:1b}]},"creativecompat:corpse":{DeathTime:1L}}
> execute in minecraft:the_end run summon corpse:corpse 100 64 0 {Tags:["c13c"],NoGravity:1b,Death:{PlayerName:"Test",MainInventory:[{Slot:0b,id:"minecraft:stone",Count:1b}]},"creativecompat:corpse":{DeathTime:1L}}
sleep 3
