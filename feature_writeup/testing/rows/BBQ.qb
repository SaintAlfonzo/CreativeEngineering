> pbot hold bbq5 minecraft:flint_and_steel
> pbot use bbq5 216 -60 500 up
> execute if block 212 -60 500 barbequesdelight:grill[lit=true] run say BBQ05 lit 212
> execute if block 216 -60 500 barbequesdelight:grill[lit=true] run say BBQ05 lit 216
