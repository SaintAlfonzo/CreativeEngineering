shell python3 -I $INST/tools/scratch_query/efb_judge.py under logs/latest.log --box {RV1-304} {RV3-304} {RV1+304} {RV3+304} --except 'mineshaft|stronghold|ancient_city|buried_treasure|monument|shipwreck|ocean_ruin|underwater|fortress|dungeon|trial|catacomb|cave|ratatouilles|squids|mansion|balloon|sky|meteorite|ship|raft|village_ocean|outpost_ocean|wreckage|sushis|voyager|swamp_hut|witch_hut|mangrove_pillager_tower|aquaculture|pond|fisherman' --fail deepwater --fail basewater
shell grep -E '\[earth-fill\].*footprint [0-9]+ water / [0-9]+ ground.*-> kept' logs/latest.log | grep -v predicted | sed -E 's/.*footprint ([0-9]+) water \/ ([0-9]+) ground.*/\1 \2/' | awk '{ if ($1 * 2 > $2 * 3) bad++; else if ($1 >= $2) mid++ } END { print "kept over 60:40: " bad+0 "; kept 50:50 to 60:40: " mid+0; exit (bad > 0) }'
shell L=$(grep -m1 '^level-name=' server.properties | cut -d= -f2); python3 -I $INST/tools/scratch_query/efb_judge.py gone "$L" logs/latest.log --box {RV1-304} {RV3-304} {RV1+304} {RV3+304}
look RECORD the "kept 50:50 to 60:40" count from the awk line (kept at 0.5, cancelled at 0.0) in the run doc
