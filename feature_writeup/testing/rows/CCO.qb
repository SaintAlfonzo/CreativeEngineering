bootreject (?i)(ERROR|FATAL).*(creativecommon|creativecompat)
shell ls mods | grep -ciE "quark|immersive_weathering|armortrims|worldedit|create_gravity|nock_enough|CerbonsBetterBeacons|immersive-portals|heartstone|SereneSeasons"; true
shell test -f config/creativecommon-common.toml
shell test "$(grep -ciE "mixin.*(quark|immersive_weathering|armortrims|worldedit|create_gravity|nock_enough|cerbon|immersive_portals|heartstone|serene)" logs/latest.log)" = 0
> reload
sleep 10
