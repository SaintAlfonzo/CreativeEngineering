> fill {MF1+5} 200 {MF2-1} {MF1+7} 200 {MF2+1} minecraft:stone
> pbot spawn egg {MF1+3} 201 {MF2} minecraft:overworld survival
> pbot hold egg minecraft:mooshroom_spawn_egg 20
repeat 20
> pbot use egg {MF1+6} 200 {MF2} up
end
sleep 2
> execute positioned {MF1+6} 201 {MF2} as @e[type=minecraft:mooshroom,distance=..6,tag=!fgd15mf,nbt={Type:"red"}] run say FGD15c egg red
> execute positioned {MF1+6} 201 {MF2} as @e[type=minecraft:mooshroom,distance=..6,tag=!fgd15mf,nbt={Type:"brown"}] run say FGD15c egg brown
count FGD15c egg red == 20
