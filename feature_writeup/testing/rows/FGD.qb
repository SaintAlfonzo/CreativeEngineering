> forceload add {MG1-24} {MG3-24} {MG1+24} {MG3+24}
sleep 10
repeat 20
> summon minecraft:mooshroom {MG1} 300 {MG3} {Tags:["fgd15mg"],NoGravity:1b}
end
repeat 20
> summon fungidelight:inky_cap_cow {MG1} 300 {MG3} {Tags:["fgd15mg"],NoGravity:1b}
end
