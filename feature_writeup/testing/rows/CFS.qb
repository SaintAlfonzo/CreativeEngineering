> execute unless entity c2b run pbot spawn c2b 300.5 -60 296.5 minecraft:overworld survival
sleep 3
> setblock 308 -60 310 cookingforblockheads:oven[facing=north]
> setblock 308 -59 310 farmersdelight:skillet[facing=north]
> setblock 312 -60 310 cookingforblockheads:oven[facing=north]
> setblock 312 -59 310 brewinandchewin:keg[facing=north]
