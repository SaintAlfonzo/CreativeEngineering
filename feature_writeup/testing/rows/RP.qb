bootreject Diet ladder \(.*\): (toggle|V3|V4|V5|V6|V10)
bootreject Diet ladder \(.*\): .*toggle
shell grep -nE "Diet ladder|skipped [0-9]+ entries" logs/latest.log | cut -c1-300
