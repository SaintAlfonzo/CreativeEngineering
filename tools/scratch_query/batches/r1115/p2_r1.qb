# r1115 phase 2: Power Grid P11 fixes on gate jar -18 (jar_archive/pwg_gate/backportedPowerGrid-0.6.2-ce-19.2-18.jar,
# sha1 e2163c7f573f, same file as mods/), fresh superflat world p2pwg. Queue section "SQ-PWG Power Grid P11 fixes,
# 2026-11-14" plus the rows rewritten in place (SQ-PWG-06, -43, -80, -82, -91). Run order of the section: -91, -97, -43,
# -06, -80, -80b, -82; -54 (prerequisite of -54r) on this boot, -54r on the restart (p2_r2.qb).
# Prereq rows copied unchanged from r1113pwg/pwgr1.qb (r1114 phase 5 latest passing): SETUP9, -76, SETUP15, -78, -79;
# -54 from r1113pwg/pwgr1r.qb (X 1340). -06 blocks diode to regulator copied unchanged, thyratron rewritten to the
# 11-14 row (grid -30 first, heater warm, anode at 0 then 200; latch and anode-break steps); heater 6.5 V as the pwg12
# batch fix (row says 6). -43 servo part only (as r1114: rheostat and variac unchanged since r1113 PASS), row text
# 11-14. -80 adds rotten flesh; -80b and -97 new; -82 per the 11-14 row (depots filled before the feed; loose parts on
# the belt recorded, not rejected).
# Prep: NOSWAP=1 PGJAR=$INST/jar_archive/pwg_gate/backportedPowerGrid-0.6.2-ce-19.2-18.jar prep_srv.sh OUT p2pwg A
#   spawn-animals=true spawn-npcs=true; the 13 pwg probes as zz_<name>.js; loading protection 1 s.
pace 1

## SQ-PWG-P11B | boot check on -18 (not a row): version, recipes, probe checks, mixins
bootexpect Done \(
bootexpect Power grid starting, prepare to be electrocuted
bootreject InvalidInjectionException|InjectionError|Critical injection failure|Mixin apply failed
bootreject ^(?!.*RuntimeDistCleaner).*(/ERROR\]|@Redirect|conflict).*powergrid\.mixins\.json
> forceload add 1090 990 1140 1260
> forceload add 1090 1695 1130 1800
> forceload add 1135 1855 1200 1915
> forceload add 1095 1995 1135 2085
> forceload add 1095 2095 1112 2112
sleep 10
> gamerule doMobSpawning false
> gamerule doFireTick false
> weather clear
> time set noon
> zpwg mods powergrid
waitlog \[zpwg\] done 30
> zpwg3 recipes powergrid
waitlog \[zpwg3\] recipes \d+ 30
> zpwg9c check
waitlog \[zpwg9c\] done 30
> zpwg10 check
waitlog \[zpwg10\] done 30
expect \[zpwg\] mod powergrid 0\.6\.2-ce-19\.2-18
reject \[zpwg3\] recipe powergrid:mixing/acid\b
reject \[zpwg\w*\] (error|config error|\S+ error)
look recipe count vs 116 on -17 (acid replaced by the pack script); zpwg9c recipes line mixing/acid= (pack script removes it)

## SQ-PWG-SETUP9 | clear the animals generated in the forceloaded chunks (not a row)
> kill @e[type=!minecraft:player]
sleep 2

## SQ-PWG-91 | 11-14 row: attachments, helper, drops (B36: tile and attachment every break), wrench, reattach junction and solar, drops again
> zpwg3 place 1100 -58 2010 powergrid:ceiling_tile
waitlog \[zpwg3\] done 20
> zpwg3 place 1102 -58 2010 powergrid:ceiling_tile
> zpwg3 place 1104 -58 2010 powergrid:ceiling_tile
> zpwg3 place 1106 -58 2010 powergrid:ceiling_tile
> zpwg3 place 1108 -58 2010 powergrid:ceiling_tile
> zpwg10 attach 1100 -58 2010 powergrid:factory_light
> zpwg10 attach 1102 -58 2010 powergrid:wire_connector
> zpwg10 attach 1104 -58 2010 powergrid:cord_junction
> zpwg10 attach 1106 -58 2010 powergrid:solar_panel
> zpwg10 attach 1108 -58 2010 minecraft:stone
> zpwg10 helper 1100 -58 2010 south
> zpwg10 helper 1108 -58 2010 east
> zpwg6 bulb 1100 -58 2010 powergrid:light_bulb
> zpwg10 drops 1100 -58 2010
> zpwg10 drops 1102 -58 2010
> zpwg10 drops 1100 -58 2010
> zpwg10 drops 1102 -58 2010
> zpwg10 wrench 1100 -58 2010
> zpwg10 wrench 1102 -58 2010
> zpwg10 wrench 1104 -58 2010
> zpwg10 wrench 1106 -58 2010
> zpwg10 attach 1104 -58 2010 powergrid:cord_junction
> zpwg10 attach 1106 -58 2010 powergrid:solar_panel
> zpwg10 drops 1104 -58 2010
> zpwg10 drops 1106 -58 2010
> zpwg10 drops 1104 -58 2010
> zpwg10 drops 1106 -58 2010
sleep 1
expect \[zpwg10\] attach powergrid:factory_light result=(SUCCESS|CONSUME) block powergrid:ceiling_tile -> powergrid:ceiling_tile_lamp state=.*state=empty.* hand=powergrid:factory_light x1$
expect \[zpwg10\] attach powergrid:wire_connector result=(SUCCESS|CONSUME) block powergrid:ceiling_tile -> powergrid:ceiling_tile_connector .*hand=powergrid:wire_connector x1$
count \[zpwg10\] attach powergrid:cord_junction result=(SUCCESS|CONSUME) block powergrid:ceiling_tile -> powergrid:ceiling_tile_junction .*hand=powergrid:cord_junction x1$ == 2
count \[zpwg10\] attach powergrid:solar_panel result=(SUCCESS|CONSUME) block powergrid:ceiling_tile -> powergrid:ceiling_tile_solar .*hand=powergrid:solar_panel x1$ == 2
expect \[zpwg10\] attach minecraft:stone result=PASS block powergrid:ceiling_tile -> powergrid:ceiling_tile .*hand=minecraft:stone x2$
expect \[zpwg10\] helper south result=(SUCCESS|CONSUME) .*south=powergrid:ceiling_tile .*hand=powergrid:ceiling_tile x3$
expect \[zpwg10\] helper east result=(SUCCESS|CONSUME) .*east=powergrid:ceiling_tile .*hand=powergrid:ceiling_tile x3$
expect \[zpwg6\] bulb powergrid:light_bulb
count \[zpwg10\] drops powergrid:ceiling_tile_lamp -> (?=.*powergrid:ceiling_tile x1)(?=.*powergrid:factory_light x1)(?=.*powergrid:light_bulb x1) == 2
count \[zpwg10\] drops powergrid:ceiling_tile_connector -> (?=.*powergrid:ceiling_tile x1)(?=.*powergrid:wire_connector x1) == 2
count \[zpwg10\] drops powergrid:ceiling_tile_junction -> (?=.*powergrid:ceiling_tile x1)(?=.*powergrid:cord_junction x1) == 2
count \[zpwg10\] drops powergrid:ceiling_tile_solar -> (?=.*powergrid:ceiling_tile x1)(?=.*powergrid:solar_panel x1) == 2
expect \[zpwg10\] wrench powergrid:ceiling_tile_lamp face=north result=SUCCESS -> powergrid:ceiling_tile got: (?=.*powergrid:light_bulb x1)(?=.*powergrid:factory_light x1)
expect \[zpwg10\] wrench powergrid:ceiling_tile_connector face=north result=SUCCESS -> powergrid:ceiling_tile got: powergrid:wire_connector x1$
expect \[zpwg10\] wrench powergrid:ceiling_tile_junction face=north result=SUCCESS -> powergrid:ceiling_tile got: powergrid:cord_junction x1$
expect \[zpwg10\] wrench powergrid:ceiling_tile_solar face=north result=SUCCESS -> powergrid:ceiling_tile got: powergrid:solar_panel x1$
reject \[zpwg10\] (attach|helper|wrench|drops) .*error
reject An unexpected error occurred trying to execute that command
reject \[zpwg\w*\] (error|unknown subcommand)
reject ^(?!.*RuntimeDistCleaner).*(Exception|/ERROR\]).*(powergrid|patryk)
look helper neighbours; lamp state after the bulb; every drops line lists tile and attachment (B36)

