## SQ-AZW-01 | rerun: azalea trees grow quark:azalea_log; logs stay azalea; 4 woods merged into oak; no item_dict Missing (sunflower_stem)
shell grep -h "\[removedWoods\]" logs/kubejs/startup.log | cut -c1-200
shell grep -qE "\[removedWoods\] 4 woods merged into oak" logs/kubejs/startup.log
shell grep -h "\[item_dict\] Missing" logs/kubejs/startup.log | head -5; test "$(grep -c "\[item_dict\] Missing" logs/kubejs/startup.log)" = 0
shell test "$(grep -c "sunflower_stem" logs/kubejs/startup.log)" = 0 || grep -h sunflower_stem logs/kubejs/startup.log | head -3
> place feature minecraft:azalea_tree 2105 -60 2130
> place feature minecraft:azalea_tree 2115 -60 2130
> place feature minecraft:azalea_tree 2125 -60 2130
> setblock 2135 -61 2130 minecraft:moss_block
> setblock 2135 -60 2130 minecraft:azalea
> clear m3
> pbot hold m3 minecraft:bone_meal 32
repeat 8
> pbot use m3 2135 -60 2130 up
end
> zq count 2100 -61 2125 2140 -40 2135 quark:azalea_log
waitlog \[zq\] count quark:azalea_log: \d+ 60
> zq count 2100 -61 2125 2140 -40 2135 minecraft:oak_log
waitlog \[zq\] count minecraft:oak_log: \d+ 60
expect \[zq\] count quark:azalea_log: [1-9]\d*
expect \[zq\] count minecraft:oak_log: 0\b
> clear m3
> give m3 quark:azalea_log 4
sleep 2
> zp inv m3
waitlog \[zp\] done 20
expect quark:azalea_log
look trunks quark:azalea_log, no oak_log; inventory keeps quark:azalea_log x4

