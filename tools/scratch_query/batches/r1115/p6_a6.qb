# r1115 phase 6, A1 fifth follow-up: as p6_a5.qb after the toolStack enchant fix (copy returned by KubeJS enchant).
# reference (coal ore 1 to 4, melon 3 to 9 with Fortune III).
pace 0.5

## SQ-SY-15e | Fortune reference after the enchant fix: sy roll on coal ore and melon with Fortune III against /loot mine
shell cp "$INST/tools/soil_yield_probe/sy_probe.js" kubejs/server_scripts/zz_sy_probe.js && echo copied
> reload
sleep 40
> syt roll 1020 -60 1000 600 minecraft:diamond_pickaxe@fortune=3
> syt roll 1018 -60 1000 600 minecraft:diamond_hoe@fortune=3
repeat 5
> loot spawn 1020 -50 1000 mine 1020 -60 1000 minecraft:diamond_pickaxe{Enchantments:[{id:"minecraft:fortune",lvl:3s}]}
> loot spawn 1018 -50 1000 mine 1018 -60 1000 minecraft:diamond_pickaxe{Enchantments:[{id:"minecraft:fortune",lvl:3s}]}
end
> kill @e[type=minecraft:item]
reject \[syt\] error
look nbt shows fortune lvl 3; coal mean about 2.2, melon F3 mean above 5.0 (max 9)

