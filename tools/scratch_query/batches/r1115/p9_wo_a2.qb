# r1115 phase 9, boot A1 part 1: SQ-WO-15 to -25 (r1109wo b2_short_timers.qb rows, srv toml as r1109wo step a2).
# randomTickSpeed 0 throughout, except the window in SQ-WO-14. Deviations from the queue text, scratch-only:
# timer rows run at pace 0.2 (at 2 s per command the 5 s timers expire before they are read);
# SQ-WO-14 opens a short random-tick window then reads at once (a 5 s tired sleep inside a 90 s wait is usually over);
# SQ-WO-18 and the angry case of -28 make the tree angry by waking a sleeper, so it has a real timer (a bare [state=angry] has none and sleeps within 23 ticks);
# SQ-WO-28 uses one Z per case (a fresh tree, no leftover blow or cooldown).
pace 1

## SETUP-A2 | forceload, bots
> forceload add 270 290 900 320
sleep 8
> pbot spawn G 280 -60 280 minecraft:overworld survival
> pbot spawn H 276 -60 280 minecraft:overworld survival
sleep 3
> gamerule randomTickSpeed 0
> weather clear
> time set noon

pace 0.5
pace 0.2
## SQ-WO-15 | timer ends at night: stays asleep, wakes right after dawn
> time set noon
> setblock 450 -60 300 mysticaloaktree:wise_oak[state=angry]
sleep 3
> time set midnight
sleep 8
> zwo state 450 -60 300
> data get block 450 -60 300 creativeworldgen_sleep_until
> time set noon
sleep 3
> zwo state 450 -60 300
sleep 1
expect \[zwo\] 450 -60 300 .*state=sleeping
expect \[zwo\] 450 -60 300 .*state=(none|blinking)

## SQ-WO-16 | wake a sleeper: trust -20, angry timer, timed sleep, awake
> time set noon
> setblock 460 -60 300 mysticaloaktree:wise_oak[state=sleeping]
> wiseoak trust 460 -60 300 G 30
> pbot use G 460 -60 300 up
> zwo state 460 -60 300
> wiseoak trust 460 -60 300 G
> data get block 460 -60 300 creativeworldgen_angry_until
sleep 7
> zwo state 460 -60 300
> data get block 460 -60 300 creativeworldgen_sleep_until
sleep 7
> zwo state 460 -60 300
sleep 1
expect \[zwo\] 460 -60 300 .*state=angry
expect Trust of G at .*: 10
expect \[zwo\] 460 -60 300 .*state=sleeping
expect \[zwo\] 460 -60 300 .*state=(none|blinking)
count has the following block data == 2

pace 1
## SQ-WO-17 | trust floor
> setblock 470 -60 300 mysticaloaktree:wise_oak[state=sleeping]
> wiseoak trust 470 -60 300 G 10
> pbot use G 470 -60 300 up
> wiseoak trust 470 -60 300 G
sleep 1
expect Trust of G at .*: 0

pace 0.2
## SQ-WO-18 | angry tree ignores a talk: no trust, no gift
> setblock 480 -60 300 mysticaloaktree:wise_oak[state=sleeping]
> pbot use G 480 -60 300 up
> wiseoak trust 480 -60 300 G 50
> pbot use G 480 -60 300 up
> wiseoak trust 480 -60 300 G
> zwo drops 480 -60 300 3
sleep 1
expect use PASS
expect Trust of G at .*: 50
expect \[zwo\] drops none

## SQ-WO-19 | a hit blows, then anger with a timer, sleep, awake
> time set noon
> setblock 490 -60 300 mysticaloaktree:wise_oak
> wiseoak trust 490 -60 300 G 50
> zwo punch G 490 -60 300
> zwo state 490 -60 300
> wiseoak trust 490 -60 300 G
sleep 3
> zwo state 490 -60 300
> data get block 490 -60 300 creativeworldgen_angry_until
sleep 7
> zwo state 490 -60 300
sleep 7
> zwo state 490 -60 300
sleep 1
expect \[zwo\] 490 -60 300 .*state=(blowing|thicc)
expect Trust of G at .*: 30
expect \[zwo\] 490 -60 300 .*state=angry
expect has the following block data
expect \[zwo\] 490 -60 300 .*state=sleeping
expect \[zwo\] 490 -60 300 .*state=(none|blinking)

## SQ-WO-20 | a second hit restarts the blow
> setblock 500 -60 300 mysticaloaktree:wise_oak
> zwo punch G 500 -60 300
sleep 1
> zwo punch G 500 -60 300
sleep 0.8
> zwo state 500 -60 300
sleep 2
> zwo state 500 -60 300
sleep 1
expect \[zwo\] 500 -60 300 .*state=(blowing|thicc)
expect \[zwo\] 500 -60 300 .*state=angry

## SQ-WO-21 | a hit on a sleeper blows
> time set noon
> setblock 510 -60 300 mysticaloaktree:wise_oak[state=sleeping]
> zwo punch G 510 -60 300
> zwo state 510 -60 300
sleep 3
> zwo state 510 -60 300
sleep 1
expect \[zwo\] 510 -60 300 .*state=(blowing|thicc)
expect \[zwo\] 510 -60 300 .*state=angry

## SQ-WO-22 | angry sleep at night stays asleep past its timer
> time set midnight
> setblock 520 -60 300 mysticaloaktree:wise_oak[state=sleeping]
> pbot use G 520 -60 300 up
> zwo state 520 -60 300
sleep 7
> zwo state 520 -60 300
sleep 7
> zwo state 520 -60 300
> time set noon
sleep 3
> zwo state 520 -60 300
sleep 1
expect \[zwo\] 520 -60 300 .*state=angry
count \[zwo\] 520 -60 300 .*state=sleeping == 2
expect \[zwo\] 520 -60 300 .*state=(none|blinking)

