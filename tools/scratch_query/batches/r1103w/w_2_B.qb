# Run r1102b, worldgen slice, boot W1b: the W1 world "wge" restarted (same OUT_W1, no prep).
# Before boot (w_setup.md W1b): delete the searchTimeoutSeconds line from OUT_W1/srv/config/creativeworldgen-common.toml
# (SQ-WGE-02a: Forge writes the default back). Same RES as w_1_B.qb (captures L6A..L6D).
pace 2

## SQ-WGE-02a | searchTimeoutSeconds: line removed before boot, Forge writes 120 back
bootexpect Done \(
shell grep -n 'searchTimeoutSeconds' config/creativeworldgen-common.toml; grep -qE '^\s*searchTimeoutSeconds = 120' config/creativeworldgen-common.toml

## SQ-WGE-06d-r1 | restart pair, second boot: minecraft:village_plains from 0 0 at the same place
> execute positioned 0 70 0 run locate structure minecraft:village_plains
waitlog (nearest minecraft:village_plains.* is at|type "?minecraft:village_plains|minecraft:village_plains.*timed out|Could not find) 200
capture R6A nearest minecraft:village_plains.* is at \[(-?\d+), (~|-?\d+), (-?\d+)\]
shell echo "first {L6A1} {L6A3}, after restart {R6A1} {R6A3}"; [ "{L6A1} {L6A3}" = "{R6A1} {R6A3}" ]

