## SQ-WGE-03a | undead castle fits plains + taiga, not highlands; override string read
shell python3 -c "import json;t=json.load(open('kubejs/generation_scripts/worldgen/structure_tags.json'))['tags'];c='eugene:undead_castle';r=[k for k in ('land/plains','land/taiga','land/highlands') if c in t.get(k,{}).get('values',[])];print(r);exit(0 if r==['land/plains','land/taiga'] else 1)"; r=$?; grep -n 'undead_castle' config/creativeworldgen-common.toml; exit $r
