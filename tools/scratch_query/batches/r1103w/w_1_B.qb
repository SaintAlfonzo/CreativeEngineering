shell for v in "SN {SN1} {SN3}" "BV {BV1} {BV3}" "VO {VO1} {VO3}"; do set -- $v; echo "== $1"; python3 -I $INST/tools/scratch_query/efb_judge.py under logs/latest.log --box $(($2-300)) $(($3-300)) $(($2+300)) $(($3+300)) --except '(underground|mineshaft|stronghold|ancient_city|trial|dungeon|monument|shipwreck|ocean_ruin|buried|fossil|geode|catacomb|crypt|cave|bunker|vault|tomb|sewer|lair|deep|mine)' --fail foreign | grep -v "^  "; done
shell f=0; for v in "SN {SN1} {SN3}" "BV {BV1} {BV3}" "VO {VO1} {VO3}"; do set -- $v; python3 -I $INST/tools/scratch_query/efb_judge.py under logs/latest.log --box $(($2-300)) $(($3-300)) $(($2+300)) $(($3+300)) --except '(underground|mineshaft|stronghold|ancient_city|trial|dungeon|monument|shipwreck|ocean_ruin|buried|fossil|geode|catacomb|crypt|cave|bunker|vault|tomb|sewer|lair|deep|mine)' --fail foreign > /dev/null || f=1; done; exit $f
shell grep '\[zq\] under ' logs/latest.log | grep -E 'base earth: [^|]*(terracotta|red_sand|basalt|snow)' | cut -c1-400 | head -20
look badlands bases terracotta / red sand, volcanic stone or basalt family, snowy snow or dirt under snow per ring (ground_match/exempt is empty today)

