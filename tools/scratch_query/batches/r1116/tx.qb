expect verb=state pos=900,-60,900 .*be=minecraft:chest shape_top=0.875 .*biome=minecraft:plains
expect verb=be be=minecraft:chest nbt=".*id:\\"minecraft:chest\\"
expect verb=place placed=true state="?minecraft:oak_leaves\[
count verb=place done=1 == 2

