# reader and bell, Z 1645
> zpwg3 place 1298 -60 1645 create:creative_motor facing=east
> zpwg3 place 1299 -60 1645 create:shaft axis=x
> zpwg3 place 1300 -60 1645 powergrid:punch_card_reader facing=north
> zpwg3 scroll 1298 -60 1645 -16
> zpwg3 place 1303 -60 1645 powergrid:alarm_bell facing=north
> zpwg3 src 1300 -60 1649 10
> zpwg3 w 1300 -60 1649 0 1300 -60 1645 0
> zpwg3 w 1300 -60 1649 1 1303 -60 1645 1
> zpwg3 w 1303 -60 1645 0 1300 -60 1645 1
> zpwg8 reader 1300 -60 1645
> zpwg8 card 1300 -60 1645 01000100010001000100010001000100
pace 0.2
repeat 10
> zpwg8 reader 1300 -60 1645
> zpwg8 bell 1303 -60 1645
end
pace 1
sleep 10
> zpwg8 reader 1300 -60 1645
> zpwg8 extract 1300 -60 1645
# side insert, motor the other way
> zpwg3 scroll 1298 -60 1645 16
> zpwg8 card 1300 -60 1645 ff000000000000000000000000000080 side
pace 0.2
repeat 5
> zpwg8 reader 1300 -60 1645
sleep 0.6
end
pace 1
# hopper
> zpwg8 extract 1300 -60 1645
> zpwg8 reader 1300 -60 1645
> setblock 1300 -59 1645 minecraft:hopper[facing=down]{Items:[{Slot:0b,id:"powergrid:punch_card",Count:1b,tag:{Data:[B;1b,0b,1b,0b,1b,0b,1b,0b,1b,0b,1b,0b,1b,0b,1b,0b]}}]}
sleep 1
> zpwg8 reader 1300 -60 1645
# B15: a card in a broken reader is dropped
> setblock 1300 -59 1645 minecraft:air
> setblock 1300 -60 1645 minecraft:air destroy
sleep 1
> zpwg8 drops 1300 -60 1645 2
