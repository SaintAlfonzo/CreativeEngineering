bootreject (?i)barbequesdelight.*(exception|failed to parse|missing)
kjsreject (?i)(warn|error).*(barbequesdelight|bbqSkewering|bbqGrilling|bbqCombine)
shell grep -hn "barbequesdelight\|bbq" logs/kubejs/server.log logs/kubejs/startup.log | grep -i "warn\|error" | head; true

## SQ-STK-01 | stack sizes applied, no missing dict key
bootexpect \[stack_sizes\] set 1341 stack sizes
bootreject no item_dict key
kjsreject no item_dict key

## SQ-NDM-01 | Nether's Delight member: one mod, mixin applies
bootexpect \[creativedelight\] members: \[.*\bnethersdelight\b
bootreject (?i)nethersdelight.*(duplicate|mixin.*(error|fail)|exception)
bootreject (?i)duplicate mods? .*nethersdelight
shell ! ls mods | grep -i "^NethersDelight-1.19-3.1"
shell grep -hE "nethersdelight.ce.mixins|FungusColonyRulesMixin|nethersdelight.*1.19-3.1-ce" logs/latest.log logs/debug.log 2>/dev/null | head -8; true
look rows/SQ-NDM-01.shell.txt: version 1.19-3.1-ce-19.2-01 and the mixin config listed; the display name "Nether's Delight (Creative Delight)" is a client mod-list check

