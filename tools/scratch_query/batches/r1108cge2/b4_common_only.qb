# r1108cge2 boot 4: tools/scratch_query/cc_only_srv.sh OUT cge2c full difficulty=normal (Common 13:51 + its optional
# mods, no Compat or other Creative jar), probe zz_cge_probe.js. Common's low gravity needs nothing from Compat.
pace 2

## SQ-CGE-15 | Common without Compat: no helper pack, low gravity for every type, Create Gravity's own tags only
bootreject Mixin apply failed|InvalidMixinException|InjectionError|InvalidInjectionException
shell grep -E "packs in order" logs/kubejs/startup.log | grep -v "_helpers" | grep -q "creativecommon, startup_scripts" && echo "order ok"
shell test "$(grep -c '\[ERROR\]' logs/kubejs/startup.log)" = 0 && echo "0 startup errors"
> execute in minecraft:the_end run forceload add 0 0 6 18
> forceload add 0 0 6 18
> zgv dropall the_end 0 140 0
waitlog \[zgv\] drop done dim=minecraft:the_end 20
> zgv dropall overworld 0 200 0
waitlog \[zgv\] drop done dim=minecraft:overworld 20
shell python3 "$INST/tools/scratch_query/cge_judge.py" logs/latest.log the_end overworld low
> zq itemtag create_gravity:backtanks
expect itemtag create_gravity:backtanks \(2\)
look order line without a _helpers pack; 9 types at about 0.2; backtanks = Create's two (Compat absent)
