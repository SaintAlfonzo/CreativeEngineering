> fill 4464 1 80 4496 16 112 minecraft:stone
> place feature hearthandharvest:salt_cave 4480 0 96
> zhh2 countset 4464 -16 80 4496 16 112 salt:raw_rock_salt_block,minecraft:calcite,minecraft:tuff,minecraft:cave_air,salt:salt_cluster,salt:large_salt_bud,salt:medium_salt_bud,salt:small_salt_bud,minecraft:water
