## SQ-OB-02 | display names after /dumpall
> dumpall
waitlog \[dumpall\].*(ok|done) 900
shell python3 -c 'import json;d=json.load(open("kubejs/exported/display_names.json"));d=d.get("items",d) if isinstance(d,dict) else d;ids=["vintagedelight:salt_dust","corn_delight:corn"];print({k:(d.get(k) if isinstance(d,dict) else None) for k in ids});print([(k,v) for k,v in (d.items() if isinstance(d,dict) else []) if "spool" in k or "patty" in k][:10])'
