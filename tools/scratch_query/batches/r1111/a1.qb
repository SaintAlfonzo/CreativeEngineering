## SQ-BRA-01 | BlockRunner tier overlap check and block tag timing
bootexpect BlockRunner tier overlaps checked: \d+ ids, 0 overlap
shell grep -n "BlockRunner tier overlaps checked\|block tags starting\|block tags finished" logs/latest.log | cut -c1-220
## SQ-BRA-02 | /dumpsurface writes surface_audit.json
> dumpsurface
sleep 15
shell python3 -c "import json;d=json.load(open('kubejs/exported/surface_audit.json'));b=d.get('blocks',d);print(type(b).__name__,len(b));print({k:d[k] for k in d if k!='blocks'} if isinstance(d,dict) else '')" 2>&1 | cut -c1-600
shell python3 -c "import json;d=json.load(open('kubejs/exported/surface_audit.json'));s=json.dumps(d);import re;[print(i, re.search(r'\"'+i+r'\"[^}]{0,300}',s).group(0) if re.search(r'\"'+i+r'\"',s) else 'MISSING') for i in ['immersivepetroleum:asphalt','minecraft:soul_sand','minecraft:white_carpet']]" 2>&1 | cut -c1-500
look surface_audit.json: asphalt tier asphalt, soul_sand no tier speedFactor 0.4, white_carpet collisionTop 0.0625, errors 0
## SQ-BRA-03 | blockrunner_scan.py --audit
shell python3 $INST/tools/blockrunner_scan.py --audit kubejs/exported/surface_audit.json 2>&1 | tail -40; echo "exit=${PIPESTATUS[0]}" 
