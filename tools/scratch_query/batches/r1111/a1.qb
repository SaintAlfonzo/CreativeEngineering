## SQ-RDB-01 | Rustic Delight with no rustic_upstream folder
bootexpect Done \(
shell ls -d rustic_upstream 2>&1; grep -iE "rustic" logs/latest.log | grep -iE "error|exception|couldn't parse|failed to load" | head -20; echo "rustic error lines: $(grep -iE 'rustic' logs/latest.log | grep -ciE "error|exception|couldn't parse|failed to load")" 
bootreject (?i)(Couldn't parse|Failed to load).*rusticdelight:
## SQ-FLR-01 | flesh recipes and result pools load
shell grep -nE "result-pools|has more outputs|visceral_heap|\[NCH\].*(flesh|pus_bubble|hair|eyebulb|blood|plantoil)|Mixing (CrushingOutputCap|ProcessingInventory|JeiCrushingPools|JeiMillingPools)" logs/latest.log | cut -c1-250 | head -40
bootreject \[result-pools\].*(?i)error
