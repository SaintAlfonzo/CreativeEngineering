shell grep -nE "Error occurred while handling event|additions\.js|endersdelight" logs/latest.log | grep -iE "error|exception|missing" | head -10 || true
shell ! grep -hE "(additions\.js|endersdelight/).*(rror|xception)" logs/kubejs/server.log logs/kubejs/startup.log
