> dumptags
waitlog (Dumped|dumptags|tags/) 300
sleep 10
shell python3 -c "import json;b=json.load(open('kubejs/exported/tags/block_tags.json'));e=json.load(open('kubejs/exported/tags/entity_type_tags.json'));i=json.load(open('kubejs/exported/tags/item_tags.json'));want=[(k,len(v)) for d in (b,i) for k,v in d.items() if k.startswith(('creativeengineering:earth_fill/','creativeengineering:ground_match/')) or k=='creativeengineering:worldgen/grass_like_soils'];want+=[(k,len(v)) for k,v in e.items() if k.endswith('bubble_column_immune')];[print(k,n) for k,n in sorted(want)];empty=[k for k,n in want if n==0];print('empty:',empty);import sys;sys.exit(1 if empty or not want else 0)"
