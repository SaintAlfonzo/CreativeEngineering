expect inv saend: .*endersdelight:amberveil_stew
expect SA4 p1 ok
expect SA4 p2 ok
expect SA4 p3 ok
expect SA4 p4 ok
expect \[zq\] makes endersdelight:crushed_voidpepper: [2-9]
> pbot remove saend
