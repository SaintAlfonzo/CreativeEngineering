## SQ-CN-04b | corn knife harvest by a player: corncobs from age 7 with a knife only (x 100..106)
> setblock 100 -61 500 minecraft:farmland
> setblock 100 -60 500 corn_delight:corn_crop[age=7,upper=false]
> setblock 100 -59 500 corn_delight:corn_crop[age=7,upper=true]
> setblock 104 -61 500 minecraft:farmland
> setblock 104 -60 500 corn_delight:corn_crop[age=3,upper=false]
> pbot spawn cn4 102.5 -60 502.5 minecraft:overworld survival
> pbot hold cn4 farmersdelight:iron_knife
> kill @e[type=minecraft:item,x=98,y=-62,z=504,dx=6,dy=8,dz=5]
# loot spawn does not break the block, so the age 7 crop stays set between rolls; drops land at z 506, away from the bot
pace 0.5
repeat 40
> execute as cn4 run loot spawn 100.5 -59 506.5 mine 100 -60 500 mainhand
end
pace 2
sleep 3
> zsb items 98 -62 504 104 -54 509
> kill @e[type=minecraft:item,x=98,y=-62,z=504,dx=6,dy=8,dz=5]
> pbot hold cn4 minecraft:air
pace 0.5
repeat 20
> execute as cn4 run loot spawn 100.5 -59 506.5 mine 100 -60 500 mainhand
end
pace 2
sleep 3
