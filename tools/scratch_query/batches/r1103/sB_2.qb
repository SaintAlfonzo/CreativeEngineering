shell grep -hoE "\[stack_sizes\] set [0-9]+ stack sizes" logs/latest.log logs/kubejs/startup.log | head -2; true
reject (Unknown (item|block|entity)|Unknown or incomplete command|Incorrect argument for command|\[(zq|zsb|zlbs)\] (error|unknown))
look the stack_sizes count is about 1341

## SQ-LBS-00 | Creative Labels 1.0.1: centre_note tag loads, no creative_labels error
bootreject Couldn't load tag creative_labels:paper/centre_note
bootreject (?i)(ERROR|Exception).*creative_labels
shell ls mods | grep -i creativeLabels; ls mods | grep -q "creativeLabels-1.0.1"

## SQ-LBS-05 | old save from 1.0.0 (sB_1) on 1.0.1: notes and labels kept, no OffX / OffY / Size keys
> zlbs dump -4 -4 170 14
waitlog \[zlbs\] DONE dump 60
expect \[zlbs\] INFO dump \S+ \S+ \S+ \S+: [1-9]\d* face_paper block entities
reject \[zlbs\] be .*\b(OffX|OffY|Size)\b
shell pre=$(for f in $(ls logs/*.log.gz | grep -v debug); do zcat "$f"; done | grep -o '\[zlbs\] be .*' | sort); post=$(grep -o '\[zlbs\] be .*' logs/latest.log | sort); echo "pre $(printf '%s\n' "$pre" | grep -c 'be ') post $(printf '%s\n' "$post" | grep -c 'be ')"; diff <(printf '%s\n' "$pre") <(printf '%s\n' "$post") && echo SAME
look rows/SQ-LBS-05.shell.txt: SAME, or only differences that keep every note and label with the same spots (and no OffX / OffY / Size key); the pre lines come from sB_1's rotated log

