# region scan after against the "before" file README Boot 1 writes; differences are judged by hand (the jar keeps
# fermenting and the pot keeps cooking between boots, so item ids in their inventories may change legitimately)
shell python3 -I $INST/tools/scratch_query/region_ids.py cdj5/region '(displaydelight|veggiesdelight|vintagedelight|fungidelight|miners_delight):[a-z_]+' > ../cdj05_after.txt; diff ../cdj05_before.txt ../cdj05_after.txt; true
look the jar, pot and basket block data lines still hold the Boot 0 contents (or their cooked results); the region diff in rows/SQ-CDJ-05.shell.txt shows no block id lost (only jar / pot item ids may change); crops and colony ids as Boot 0 recorded them

## SQ-DDP-06 | Display config carried into the CD file, takeAll inverted
shell ls config | grep -iE 'displaydelight|vintagedelight'
shell test -f config/displaydelight-common.toml.moved && test ! -f config/displaydelight-common.toml
shell test "$(grep -c 'config/displaydelight-common.toml carried into config/creativedelight-common.toml' logs/latest.log)" = 1
bootexpect \[creativedelight\] config/displaydelight-common.toml carried into config/creativedelight-common.toml \(\d+ values\) and renamed to displaydelight-common.toml.moved
bootreject could not carry|could not rename
shell awk '/^[[:space:]]*\[/{s=$0} s ~ /^[[:space:]]*\[display\][[:space:]]*$/ && !/^[[:space:]]*\[/' config/creativedelight-common.toml
shell awk '/^[[:space:]]*\[/{s=$0} s ~ /^[[:space:]]*\[display\][[:space:]]*$/ && /^[[:space:]]*takeAll[[:space:]]*=[[:space:]]*false/{f=1} END{exit !f}' config/creativedelight-common.toml
look [display] in rows/SQ-DDP-06.shell.txt holds takeAll = false and the other eight keys

## SQ-DDP-07 | (Boot 1 half, takeAll = false) bare-hand use of the Boot 0 cookie plate
# perfBot and /zq cannot sneak: the takeAll half (sneaking bare hand: 1 taken, 2 stay) goes to the client row CQ-DDP-01.
# This half is the plain bare-hand use, which takes 1 whatever takeAll says (InterationManager.tryTakeItemWithBareHand).
> kill @e[type=minecraft:item]
> pbot spawn ddp7 {H1+2} {H2} {H3-2} minecraft:overworld survival
> execute if block {H1+2} {H2} {H3} displaydelight:plated_cookie[stacks=3] run say DDP07 plate holds 3
# the starter kit puts a copper pickaxe in slot 0 (main hand): empty the hand first (r1102 judge: "use PASS", nothing taken)
> item replace entity ddp7 weapon.mainhand with minecraft:air
> pbot use ddp7 {H1+2} {H2} {H3} up
> execute if block {H1+2} {H2} {H3} displaydelight:plated_cookie[stacks=2] run say DDP07 two left
> data get entity ddp7 Inventory
expect DDP07 plate holds 3
expect DDP07 two left
expect id: "minecraft:cookie"
look sneak half not run here (no sneak in perfBot or /zq): CQ-DDP-01 does it with takeAll = false (Boot 2 world has takeAll = true, so set it back to false in the client copy for that half, or judge it in a Boot 1 copy)

## SQ-VTD8-01 | Vintage config carried; remainderBuffer = false drops the bottles on the jar
shell ls config | grep -i vintagedelight
shell test -f config/vintagedelight-common.toml.moved && test ! -f config/vintagedelight-common.toml
shell test "$(grep -c 'config/vintagedelight-common.toml carried into' logs/latest.log)" = 1
bootreject could not carry|could not rename
shell awk '/^[[:space:]]*\[/{s=$0} s ~ /\[vintage/' config/creativedelight-common.toml
shell awk '/^[[:space:]]*\[/{s=$0} s ~ /^[[:space:]]*\[vintage\.pickling_jar\][[:space:]]*$/ && /^[[:space:]]*remainderBuffer[[:space:]]*=[[:space:]]*false/{f=1} END{exit !f}' config/creativedelight-common.toml
shell awk '/^[[:space:]]*\[/{s=$0} s ~ /^[[:space:]]*\[vintage\.pickling_jar\][[:space:]]*$/ && /^[[:space:]]*stallWhenFull[[:space:]]*=/{f=1} END{exit !f}' config/creativedelight-common.toml
shell awk '/^[[:space:]]*\[/{s=$0} s ~ /^[[:space:]]*\[vintage\.worldgen\][[:space:]]*$/ && /^[[:space:]]*magicVineConvertsDirtToLushGrass[[:space:]]*=/{f=1} END{exit !f}' config/creativedelight-common.toml
> zq rdetail fermented_garlic
> kill @e[type=minecraft:item]
> setblock {H1} {H2} {H3+16} vintagedelight:fermenting_jar
# 3 batches of 4 garlic cloves + 1 honey bottle (veggiesdelight compat fermenting recipe, 600 ticks each); put in by
# NBT instead of from the top: a hopper above the jar would pick up the bottles the row looks for
> data merge block {H1} {H2} {H3+16} {inventory:{Size:10,Items:[{Slot:0b,id:"veggiesdelight:garlic_clove",Count:3b},{Slot:1b,id:"veggiesdelight:garlic_clove",Count:3b},{Slot:2b,id:"veggiesdelight:garlic_clove",Count:3b},{Slot:3b,id:"veggiesdelight:garlic_clove",Count:3b},{Slot:4b,id:"minecraft:honey_bottle",Count:3b}]}}
sleep 100
> data get block {H1} {H2} {H3+16} inventory
> zcount {H1-1} {H2} {H3+15} {H1+1} {H2+2} {H3+17}
waitlog \[zcount\] entities 30
expect \{(?=[^{}]*Slot: 7b?[,}])(?=[^{}]*"veggiesdelight:fermented_garlic_honey")(?=[^{}]*Count: 3b)[^{}]*\}
reject has the following block data: .*Slot: 9b?[,}]
expect \[zcount\] entities .*item:minecraft:glass_bottle x
look the rdetail line shows the 4 cloves + honey bottle recipe (else the batch's inputs are wrong: BATCH-FAULT); 3 glass bottles in total lie on the jar

## SQ-CDFW-10 | tool_dict.js / misc_dict.js load without a thrown check
shell grep -nE "tool_dict|misc_dict" logs/kubejs/startup.log | head -5
shell grep -q "Loaded script startup_scripts:_lib/tool_dict.js" logs/kubejs/startup.log && grep -q "Loaded script startup_scripts:_lib/misc_dict.js" logs/kubejs/startup.log
shell ! grep -nE "tool_dict|misc_dict" logs/kubejs/startup.log logs/latest.log | grep -iE "error|throw|missing|warn"
