> setblock 80 -59 -60 farmersrespite:kettle
> data merge block 80 -59 -60 {Inventory:{Items:[{Slot:0b,id:"farmersrespite:black_tea_leaves",Count:1b},{Slot:1b,id:"farmersrespite:black_tea_leaves",Count:1b}]},FluidTank:{FluidName:"minecraft:water",Amount:1000}}
