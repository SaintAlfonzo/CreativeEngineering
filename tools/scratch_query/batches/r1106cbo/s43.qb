# r1106cbo single boot: chain + ADD="upgrade_aquatic-*.jar,blueprint-*.jar", group A (SQ-CBO-43)
## SQ-CBO-43 | chain + upgrade_aquatic-*.jar,blueprint-*.jar
bootexpect \[creativebrewing\] members: \[vinery, brewinandchewin\]$
bootreject Missing or unsupported mandatory|Mixin apply failed|InvalidMixinException|creativebrewing.*(NoClassDefFoundError|ClassNotFoundException)|Encountered an unexpected exception
shell ! grep -nE "ReferenceError|TypeError|EvaluatorException|is not defined" logs/kubejs/startup.log logs/kubejs/server.log
> cbo all
waitlog \[cbo\] done 30
# the 4 unguarded echo tool rows (tool_effects.js 134-137, found r1106cbo boot 1) are tolerated; any other leak fails
expect effects leaks [04]$
reject \[cbo\] leak (?!tool onHit item creativeengineering:echo_(pickaxe|axe|shovel|hoe)$)
expect mods loaded 1 of 24: upgrade_aquatic$
> forceload add 0 0
sleep 1
> kill @e[tag=cbo]
> summon minecraft:iron_golem 0 -60 5 {Tags:["cbo"],NoAI:1b}
sleep 1
> effect give @e[tag=cbo] upgrade_aquatic:restfulness 60 0
> effect give @e[tag=cbo] upgrade_aquatic:insomnia 60 0
sleep 1
> data get entity @e[tag=cbo,limit=1] ActiveEffects
sleep 2
> kill @e[tag=cbo]
reject "forge:id": "upgrade_aquatic:restfulness"
reject "forge:id": "upgrade_aquatic:insomnia"
> zq potion upgrade_aquatic:restfulness minecraft:glowstone_dust
> zq potion upgrade_aquatic:insomnia minecraft:glowstone_dust
sleep 3
reject restfulness \+ minecraft:glowstone_dust -> minecraft
reject insomnia \+ minecraft:glowstone_dust -> minecraft
look both brews -> nothing (or the potion unregistered)
