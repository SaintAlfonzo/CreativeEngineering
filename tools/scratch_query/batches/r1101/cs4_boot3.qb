# Run 2026-11-01, Creative Split wave 4, boot 3 (split_w234.sh prep3): build/libs jars (patcherMod 1.1.07 with the
# SwapRemapper fix, CD nesting Baby Mobs and Incubation Additions, CB, Compat, Calendar, Devtools) on the boot 1/2
# world; srv CE config still holds the sections wave 4 moves, with edited values (merge path). The spawn chunk still
# holds the boot 1 blocks under creative_delight: ids, so the remap rows of SQ-CS2 are rerun here.
pace 2

## SQ-CS2-02r | swap remap with the fixed jar
bootexpect \[swaps\] 2 list file\(s\): 2 namespace move\(s\), 0 single id\(s\)
bootexpect \[swaps\] minecraft:block: 2 id\(s\) remapped to their survivors
bootreject left missing
bootreject listed id\(s\) had no survivor
shell grep -E "\[swaps\]" logs/latest.log | cut -c60-260

## SQ-CS2-03r | remapped blocks keep their states
> pbot spawn qa {H1} {H2} {H3} minecraft:overworld survival
sleep 5
> execute if block {H1+2} {H2} {H3} creativedelight:treated_stick[axis_y=true] run say CS2 stick ok
> execute if block {H1+3} {H2} {H3+3} creativedelight:treated_stick_tomatoes[age=2] run say CS2 tomato stick ok
> data get block {H1+4} {H2} {H3} Items
expect CS2 stick ok
expect CS2 tomato stick ok
> save-all flush
waitlog Saved the game 120
shell python3 $INST/tools/scratch_query/region_ids.py cs234/region "creative_?delight:[a-z_]+"
look r.-1.0 names creativedelight:treated_stick* after the save (no creative_delight: left there)

## SQ-CBJ4-01 | CB mixins
bootreject creativebrewing\.mixins\.json.*(Error|error|failed)
shell grep -c "from creativebrewing.mixins.json" logs/debug.log; grep -o "Mixing [A-Za-z_.]* from creativebrewing.mixins.json" logs/debug.log | sed 's/Mixing //;s/ from.*//' | sort -u > cb_mx.txt; wc -l < cb_mx.txt; cat cb_mx.txt | tr '\n' ' '; echo; echo "also from CE:"; grep -o "Mixing [A-Za-z_.]* from creativeengineering.mixins.json" logs/debug.log | sed 's/Mixing //;s/ from.*//' | sort -u | comm -12 - cb_mx.txt; rm -f cb_mx.txt
look 14 common mixins (minus absent mods), none also from creativeengineering.mixins.json

## SQ-CBJ4-02 | config sections merged into the CB file
bootexpect \[swaps\] config sections .*alcohol.* merged from creativeengineering-common.toml into creativebrewing-common.toml
shell grep -E "\[swaps\] config sections" logs/latest.log | cut -c60-300; grep -nE "^\s*\[|quarkLine|reductionPerLevel|intervalSeconds|chancePerPiece" config/creativebrewing-common.toml; echo CE:; grep -nE "^\[(alcohol|effects|magic_resistance|copper_poisoning)\]" config/creativeengineering-common.toml || echo "CE has none of the four"
look CB file has [alcohol] quarkLine = false, [magic_resistance] reductionPerLevel = 0.3, copper 10 / 1.0; CE file lost the four

