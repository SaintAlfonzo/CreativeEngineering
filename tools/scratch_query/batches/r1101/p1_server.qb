# Run 2026-11-01, priority run boot 1 (group A superflat, grass at y -61, air from y -60) plus the group A rows of the
# 2026-11-01 bug batch. qrun.py run OUT tools/scratch_query/batches/r1101/p1_server.qb RES
# Rows: scratch_queue.md "Priority run" and "Bug batch, 2026-11-01". Bot "qa" at 0 -60 0, spawn-animals=true.
# Areas: WCT x -40..-20 z -20..-10, HR x 20..30 z -10, KT x 40 z 0, NS x 40 z 10, TSK x -10..0 z 30, DM x 20..30 z 30,
# POT x 50..70 z 30, SVA x 100 z 100.
pace 1

## SQ-R11-BOOT | boot clean of CE / CD / CB mixin and registry errors
bootexpect Done \(
bootreject (Mixin apply failed|InvalidInjectionException|Critical injection failure).*(creativeengineering|creativedelight|creativedelight|creativebrewing|blockheads_additions)
bootreject Registry Object not present
bootreject \[NCH\].*(does not exist or is empty|error|Error)
look latest.log NCH / KubeJS lines listed by the following rows

## SQ-R11-BOT | fake player joins
> gamerule sendCommandFeedback true
> time set noon
> pbot spawn qa 0 -60 0
> pbot status
expect ceperfbot ok

## SQ-CBJ-01 | Creative Brewing nests both ports
bootexpect \[creativebrewing\] members: \[vinery, brewinandchewin\]
bootreject \[creativebrewing\].*NOT loaded
bootreject member .* is loaded from
shell grep -qE "JarInJarDependencyLocator.*backportedVinery|backportedVinery.*(JarInJar|jij)" logs/debug.log
shell grep -qE "JarInJarDependencyLocator.*backportedBrewin|backportedBrewin.*(JarInJar|jij)" logs/debug.log

## SQ-CBJ-02 | startup script order and server scripts ready
shell grep -n "startup script packs in order" logs/kubejs/startup.log | grep -q "creativedelight.*creativebrewing"
shell grep -q "\[creativebrewing\] core finished, members: vinery, brewinandchewin" logs/kubejs/startup.log logs/latest.log
shell ! grep -q "global.CD missing" logs/kubejs/startup.log logs/latest.log
shell grep -q "\[creativebrewing\] server scripts ready, members on: vinery, brewinandchewin" logs/kubejs/server.log logs/latest.log

