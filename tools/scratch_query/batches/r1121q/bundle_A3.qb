# sets rain itself (r1120lr: no rain, so the rain cases reported no rain); the melt FAIL lines of the shared probe are not
# this row's (SQ-MELT)
shell awk '/^[[:space:]]*\[/{s=$0} s ~ /^[[:space:]]*\[salt\.Dissolving\][[:space:]]*$/ && /SaltDissolvingInRain/' config/creativedelight-common.toml | grep -q "SaltDissolvingInRain = false"
shell awk '/^[[:space:]]*\[/{s=$0} s ~ /^[[:space:]]*\[salt\.Dissolving\][[:space:]]*$/ && /SaltDissolvingInRain/' $INST/configs_edited/root_config/creativedelight-common.toml | grep -q "SaltDissolvingInRain = false"
> weather rain 6000
sleep 5
> salttest
waitlog \[salttest\] done \d+ pass 600
expect \[salttest\] PASS salt:salt_block in rain, open sky, stays
expect \[salttest\] PASS salt:rock_salt_ore in rain, open sky, stays
expect \[salttest\] PASS vintagedelight:salt_bricks in rain, open sky, stays
expect \[salttest\] PASS vintagedelight:salt in rain, open sky, stays
expect \[salttest\] PASS Salt Layer beside water becomes water
expect \[salttest\] PASS salt:salt_block beside water dissolves
expect \[salttest\] NOTE rain cases: .*isRainingAt true
> weather clear 100000
