# r1113 Power Grid P6 gate boot (jar jar_archive/pwg_gate/backportedPowerGrid-0.6.2-ce-19.2-08.jar): SQ-PWG-46 to -54,
# then reruns on the rewritten row text: SQ-PWG-32, -37 (AC part), -43 (servo part, 40 V), -28, -30, -31, -36.
# SQ-PWG-45 is superseded by SQ-PWG-47 (pwg_p5_probe.js carries the 55 structures of -08; the three r1113 quirks are in
# -47's expected 15). Group A superflat, level pwg8, ground Y -61, blocks at Y -60.
# Prep:
#   COPYDEV=1 PGJAR=$INST/jar_archive/pwg_gate/backportedPowerGrid-0.6.2-ce-19.2-08.jar prep_srv.sh OUT pwg8 A
#   ls OUT/srv/mods | grep -i powergrid        (only backportedPowerGrid-0.6.2-ce-19.2-08.jar; remove -07 and older)
#   for p in pwg_probe pwg_grid_probe pwg_p3_probe pwg_p4_probe pwg_p5_probe pwg_p6_probe; do
#     cp $INST/tools/scratch_query/$p.js OUT/srv/kubejs/server_scripts/zz_$p.js; done
#   ponder datapack from the -08 jar (before boot):
#   mkdir -p OUT/pwgp OUT/srv/pwg8/datapacks/pwgponder/data/pwgponder/structures \
#     && unzip -o -q OUT/srv/mods/backportedPowerGrid-0.6.2-ce-19.2-08.jar 'assets/powergrid/ponder/*' -d OUT/pwgp \
#     && cp -r OUT/pwgp/assets/powergrid/ponder/. OUT/srv/pwg8/datapacks/pwgponder/data/pwgponder/structures/ \
#     && printf '{"pack":{"pack_format":10,"description":"PWG ponder structures, scratch only"}}' > OUT/srv/pwg8/datapacks/pwgponder/pack.mcmeta
#   No srv config edits (SQ-PWG-46 checks the defaults). SQ-PWG-54 writes the pwgsolar datapack itself (shell) and /reloads.
# Probe goggle reads log a RuntimeDistCleaner ERROR (client class): no blanket ERROR reject.
# waitlog matches anywhere since the row start; real waits are sleeps (20 ticks = 1 s) plus pace (s after each command).
# Batch deviations from the row text: SQ-PWG-48 sets the creative motors of the two Create fan lines to 64 RPM (the
# 16 RPM default gives a reach of about 1.25 blocks: the stream would not reach the head / coil / apple); P6 lines that
# only wait are built up front so their waits overlap (SQ-PWG-48 Z 1406 to 1414, SQ-PWG-49 skillet and basin heaters,
# SQ-PWG-52 LV fixture and factory light); SQ-PWG-36 expects 56 recipes on -08 (the row's 47 is the P4 count).
pace 1

## SQ-PWG-46 | -08 loads (phase 6): registries, 56 recipes, fan types, solar contraption type, 0 overrides, config, six mixin targets
bootexpect Power grid starting, prepare to be electrocuted \(1\.19\.2 port, phase 6\)
bootexpect Loaded 0 solar biome overrides
bootreject InvalidInjectionException|InjectionError|Critical injection failure
bootreject ^(?!.*RuntimeDistCleaner).*(/ERROR\]|@Redirect|conflict).*powergrid\.mixins\.json
> zpwg mods powergrid
waitlog \[zpwg\] done 30
> zpwg ns powergrid
waitlog \[zpwg\] ns powergrid total 30
> zpwg3 recipes powergrid
waitlog \[zpwg3\] recipes \d+ 30
> zpwg6 check
waitlog \[zpwg6\] done 30
sleep 1
shell grep -n -E 'powergrid\.mixins\.json|org\.patryk3211\.powergrid\.mixin' logs/latest.log | head -40; grep -n -E 'solar biome override' logs/latest.log | head
expect \[zpwg\] mod powergrid 0\.6\.2-ce-19\.2-08
expect \[zpwg\] ns powergrid block: 58\b
expect \[zpwg\] ns powergrid item: 71\b
expect \[zpwg\] ns powergrid entity_type: 3\b
expect \[zpwg\] ns powergrid block_entity_type: 48\b
expect \[zpwg\] ns powergrid menu: 2\b
expect \[zpwg\] ns powergrid recipe_type: 1\b
expect \[zpwg\] ns powergrid recipe_serializer: 1\b
expect \[zpwg3\] recipes 56$
expect recipe powergrid:crafting/electric_fan type=
expect recipe powergrid:crafting/electric_pump type=
expect recipe powergrid:crafting/factory_light type=
expect recipe powergrid:crafting/growth_lamp type=
expect recipe powergrid:crafting/light_bulb type=
expect recipe powergrid:crafting/lv_light_bulb type=
expect recipe powergrid:crafting/neon_bulb type=
expect recipe powergrid:mechanical_crafting/basin_heater type=
expect recipe powergrid:sequenced_assembly/solar_panel type=
reject recipe powergrid:crafting/heating_coil type=
reject recipe powergrid:crafting/light_fixture type=
reject recipe powergrid:crafting/solar_panel_bearing type=
expect \[zpwg6\] fan types .*powergrid:heater_blasting\(150\)
expect \[zpwg6\] fan types .*powergrid:heater_smoking\(250\)
expect \[zpwg6\] fan types .*creativeengineering:dragon_breathing\(500\)
count \[zpwg6\] fan type \S+ registered=true$ == 3
expect \[zpwg6\] contraption type powergrid:solar_panel registered=true
expect \[zpwg6\] solar biome overrides 0$
expect \[zpwg6\] config heaterFanProcessingSpeedMultiplier=0\.75 growthLampRadius=2 growthLampChance=50 electricPumpRange=24 solarPanelMaxSize=25
expect \[zpwg6\] config clientMirror=true
count \[zpwg6\] mixin target \S+ loaded$ == 6
reject \[zpwg6\] mixin target \S+ error
reject InvalidInjectionException|InjectionError|Critical injection failure
reject \[zpwg\w*\] (error|config error|contraption type error|solar overrides error)
reject ^(?!.*RuntimeDistCleaner).*(Exception|/ERROR\]).*(powergrid|patryk)
look fan types line lists Create's own types too; shell output: mixin lines name no failure; the solar override log line says 0

