# real computer: startup.lua copied into the running level (CC reads it when the computer starts)
shell mkdir -p pwg12/computercraft/computer/7 && cp $INST/tools/scratch_query/pwg_p8_cc_startup.lua pwg12/computercraft/computer/7/startup.lua && ls -la pwg12/computercraft/computer/7/
> setblock 1301 -60 1660 computercraft:computer_advanced{ComputerId:7,On:1b}
sleep 10
> zpwg3 be 1301 -59 1660
sleep 15
shell cat pwg12/computercraft/computer/7/pwg_out.txt
# display link
> zpwg3 place 1300 -60 1666 create:display_board facing=north
> zpwg3 place 1298 -60 1666 create:creative_motor facing=east
> zpwg3 place 1299 -60 1666 create:shaft axis=x
> zpwg3 scroll 1298 -60 1666 32
> zpwg3 place 1300 -59 1660 create:display_link facing=up
sleep 1
> zpwg8 dlink 1300 -59 1660 1300 -60 1666 2
> zpwg3 src 1300 -60 1657 -5
sleep 2
> zpwg8 dlink 1300 -59 1660 1300 -60 1666 2
expect \[zpwg8\] periph type=powergrid_voltage_gauge voltage=(11\.9\d*|12(\.0\d*)?)
expect \[zpwg8\] periph type=powergrid_voltage_gauge .*getValue=(11\.9\d*|12(\.0\d*)?)
expect \[zpwg8\] periph type=powergrid_current_gauge current=
expect \[zpwg8\] periph type=powergrid_redstone_converter
expect \[zpwg8\] conv override=7(\.0)?
expect \[zpwg8\] conv override=null
expect \[zpwg8\] dlink source pos=.*powergrid:voltage_gauge value=
expect \[zpwg8\] board create:display_board nbt=
expect \[zpwg8\] dlink .*activeTarget=\S*DisplayBoardTarget
reject \[zpwg8\] (periph|conv|dlink|board): no
reject \[zpwg8\] periph: none for
reject LuaException
reject \[zpwg\w*\] (error|unknown subcommand)
reject ^(?!.*RuntimeDistCleaner).*(Exception|/ERROR\]).*(powergrid|patryk)
look periph maxRange / rangePercentage = 12 / range; current gauge current= the SQ-PWG-64 gauge value; converter terminal voltage in the be reads follows override 7 then clear (record both), and the be after the computer start shows the 7 override's voltage; shell 1: startup.lua present; shell 2 (computer file): start, three "sample N peripherals=2" blocks each with a powergrid_voltage_gauge line (voltage= about 12) and a powergrid_redstone_converter line, "<side> setValue(7) ok=true" and "<side> clearValue ok=true" (record the side names), end, no error text; dlink lines: activeTarget not none (none: the board is not its own controller yet, rerun dlink after a wait); board powered by the motor on its X side (Create 0.5.1 skips a board at speed 0); board nbt text contains the gauge value with its unit (about 12 V, then about -5 V in polarized mode 2); no file: computer did not start (On:1b, computercraft/computer/7/), rerun by hand in CQ-PWG-21
