sleep 3
> zc3 portals
> pbot spawn qa 1350 -60 1030 minecraft:overworld survival
sleep 3
> clear qa
> give qa portalgun:portal_gun 1
sleep 1
> execute as qa at @s run tp @s ~ ~ ~ -20 0
> zc3 shoot qa blue
sleep 2
> execute as qa at @s run tp @s ~ ~ ~ 20 0
> zc3 shoot qa orange
sleep 2
> zc3 portals
