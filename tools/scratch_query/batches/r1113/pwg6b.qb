# r1113 Power Grid -06 boot 2 (fresh world pwg6b): SQ-PWG-17 (watch probe fix) and the generator rows (wind probe fix:
# Direction.getStepX not reachable from Rhino). Prep as pwg6.qb without the ponder datapack, level pwg6b.
pace 2

## SQ-PWG-SETUP6b | forceload the P2 area for SQ-PWG-17 (not a row)
> forceload add 990 990 1060 1030
sleep 4

## SQ-PWG-17 | overheat loop: ~120 A, watcher sees an overheated wire, burnt wires removed, drop nothing
pace 0
> zpwgg overheat 1000 -60 1020
> zpwgg watch 1000 -60 1020 8 300
> zpwgg ohm 1003 -60 1020
pace 1
repeat 10
> zpwgg ohm 1003 -60 1020
> zpwgg wires 1000 -60 1020 8
sleep 0
end
sleep 3
> zpwgg watched
sleep 1
> zpwgg items 1000 -60 1020 8
waitlog \[zpwgg\] items \d+ 30
sleep 1
expect \[zpwgg\] watched .*pass=true
expect \[zpwgg\] items 0
reject \[zpwgg\] error
reject ^(?!.*RuntimeDistCleaner).*(Exception|/ERROR\]).*(powergrid|patryk)
look first ohm about 120 A; wire count drops; last ohm I=0 or lower

# P4 reruns on -06 (pwg5: wind failed on a Rhino BlockPos.relative overload, so the B line never built)
## SQ-PWG-SETUP6 | forceload the P3 and P4 area X 1090 to 1130, Z 990 to 1260 (54 chunks); no fire spread (not a row)
> forceload add 1090 990 1130 1260
> gamerule doFireTick false
sleep 5


## SQ-PWG-38B | PWG-08 part B: generator line fed by a creative motor at 64, 128, 256 RPM, 30 V excitation, 10 ohm load
> zpwg3 place 1100 -58 1180 create:creative_motor facing=east
waitlog \[zpwg3\] done 20
> zpwg3 place 1101 -58 1180 powergrid:generator_clutch facing=west
> zpwg3 place 1102 -58 1180 powergrid:generator_induction_rotor axis=x
> zpwg3 place 1103 -58 1180 powergrid:generator_induction_rotor axis=x
> zpwg3 place 1104 -58 1180 powergrid:generator_commutator facing=east
> zpwg4 wind 1102 -57 1180 1103 -57 1180 y
> zpwg4 wind 1102 -59 1180 1103 -59 1180 y
> zpwg3 place 1101 -57 1180 powergrid:device_connector facing=east
> zpwg3 place 1101 -59 1180 powergrid:device_connector facing=east
> zpwg3 be 1101 -57 1180
> zpwg3 be 1101 -59 1180
> zpwg3 src 1098 -58 1183 30
> zpwg3 w 1098 -58 1183 0 1101 -57 1180 0
> zpwg3 w 1101 -57 1180 1 1101 -59 1180 0
> zpwg3 w 1101 -59 1180 1 1098 -58 1183 1
> zpwg3 place 1107 -60 1180 powergrid:current_gauge
> zpwg3 place 1110 -60 1180 powergrid:creative_resistor
> zpwg3 res 1110 -60 1180 36
> zpwg3 place 1110 -60 1182 powergrid:voltage_gauge
> zpwg3 w 1104 -58 1180 0 1107 -60 1180 0
> zpwg3 w 1107 -60 1180 1 1110 -60 1180 0
> zpwg3 w 1110 -60 1180 1 1104 -58 1180 1
> zpwg3 w 1110 -60 1180 0 1110 -60 1182 0
> zpwg3 w 1110 -60 1180 1 1110 -60 1182 1
sleep 2
> zpwg4 kin 1102 -57 1180
> zpwg3 scroll 1100 -58 1180 64
sleep 5
> zpwg4 kin 1101 -58 1180
> zpwg4 kin 1102 -58 1180
> zpwg4 kin 1104 -58 1180
> zpwg3 be 1107 -60 1180
> zpwg3 be 1110 -60 1182
> zpwg3 scroll 1100 -58 1180 128
sleep 5
> zpwg4 kin 1101 -58 1180
> zpwg4 kin 1102 -58 1180
> zpwg4 kin 1104 -58 1180
> zpwg3 be 1107 -60 1180
> zpwg3 be 1110 -60 1182
> zpwg3 scroll 1100 -58 1180 256
sleep 5
> zpwg4 kin 1101 -58 1180
> zpwg4 kin 1102 -58 1180
> zpwg4 kin 1104 -58 1180
> zpwg3 be 1107 -60 1180
> zpwg3 be 1110 -60 1182
count \[zpwg4\] wind 2 blocks axis=x along=true magnetic=y$ == 2
count \[zpwg3\] be Block\{powergrid:device_connector\} >= 2
expect \[zpwg4\] .*impact=104 capacityAdded
expect \[zpwg4\] network capacitySU=\S+ stressSU=6656 members
expect \[zpwg4\] network capacitySU=\S+ stressSU=13312 members
expect \[zpwg4\] network capacitySU=\S+ stressSU=26624 members
reject \[zpwg4\] winding I=\S+ field=none
reject \[zpwg\w*\] error
reject ^(?!.*RuntimeDistCleaner).*(Exception|/ERROR\]).*(powergrid|patryk)
look winding I about 1.0 A, field = f(I) (6.60 at 1.0 A, 5 %); rotor induction field = winding field / 2; rotor rpm within 5 % of clutch speed; commutator V 0.6 to 1.0 of 2 x field x RPM x pi / 30 (about 44 / 88 / 177 V at 1 A); gauge A = gauge V / 10 (5 %); V(128)/V(64) and V(256)/V(128) 1.7 to 2.3; record RPM, SU, V, A, rotor power vs V x A per speed

## SQ-PWG-39 | PWG-10 generator load on the -38 B line at 256 RPM: 1 ohm, redstone 15 decouples, back to 10 ohm
> zpwg3 res 1110 -60 1180 27
waitlog \[zpwg3\] done 20
sleep 3
> zpwg4 kin 1101 -58 1180
> zpwg4 kin 1102 -58 1180
> zpwg4 kin 1104 -58 1180
> zpwg3 be 1107 -60 1180
> zpwg3 be 1110 -60 1182
> setblock 1101 -58 1179 minecraft:redstone_block
sleep 5
> zpwg4 kin 1101 -58 1180
> zpwg4 kin 1102 -58 1180
> zpwg4 kin 1104 -58 1180
> zpwg3 be 1107 -60 1180
> zpwg3 be 1110 -60 1182
> setblock 1101 -58 1179 minecraft:air
> zpwg3 res 1110 -60 1180 36
sleep 5
> zpwg4 kin 1101 -58 1180
> zpwg4 kin 1102 -58 1180
> zpwg4 kin 1104 -58 1180
> zpwg3 be 1107 -60 1180
> zpwg3 be 1110 -60 1182
expect \[zpwg4\] network capacitySU=\S+ stressSU=26624 members
expect \[zpwg4\] .*impact=0 capacityAdded
expect \[zpwg4\] network capacitySU=\S+ stressSU=0 members
reject \[zpwg\w*\] error
