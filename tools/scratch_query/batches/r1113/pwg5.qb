shell s=pwg5/serverconfig/powergrid-server.toml; grep -n -A1 -E 'rotorKp|rotorKd|rotorRPMMax|rotorAssemblyMaxSize|dangerousGenerators|torqueForStress|motorDynamicResistance|motorMinimumLoad|windingCoilConstant|fieldSaturationCurrent' $s; grep -n -E '^\s*(electric_motor|constant_speed_motor|servo|generator_[a-z_]+|variac|rheostat) =' $s; m=0; for k in 'rotorKp = 0.85' 'rotorKd = 0.002' 'rotorRPMMax = 272' 'rotorAssemblyMaxSize = 8' 'dangerousGenerators = true' 'torqueForStress = 15.0' 'motorDynamicResistance = true' 'motorMinimumLoad = 0.05' 'windingCoilConstant = 5.0' 'fieldSaturationCurrent = 2.0' 'generator_clutch = 32.0' 'generator_induction_rotor = 32.0' 'generator_large_induction_rotor = 128.0' 'generator_commutator = 8.0' 'generator_vertical_commutator = 8.0' 'variac = 0.0' 'rheostat = 0.0' 'electric_motor = 64.0' 'constant_speed_motor = 64.0' 'servo = 32.0'; do grep -qF -- "$k" $s || { echo "MISSING $k"; m=1; }; done; exit $m
