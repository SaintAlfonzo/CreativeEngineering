expect \[zpwg\] ns powergrid block: 49\b
expect \[zpwg\] ns powergrid item: 58\b
expect \[zpwg\] ns powergrid entity_type: 3\b
expect \[zpwg\] ns powergrid block_entity_type: 40\b
