expect \[zpwg\] ns powergrid recipe_serializer: 1\b
expect \[zpwg\] ns powergrid fluid: 0\b
expect \[zpwg4\] stress electric_motor capacity=64(\.0)? .*rpm=0(\.0)?\.\.256(\.0)?$
expect \[zpwg4\] stress constant_speed_motor capacity=64(\.0)? .*rpm=0(\.0)?\.\.256(\.0)?$
expect \[zpwg4\] stress servo capacity=32(\.0)? .*rpm=0(\.0)?\.\.32(\.0)?$
