# r1113 chunk 1, boot A1: group A superflat (prep_srv.sh defaults), level c1a1. Current jars (prep_srv.sh swaps the
# newer build/libs jars in: Common 11-12 20:46, CD 11-11 16:52; the CD jar in mods/ (11-10 21:20) is older).
# Setup before boot (server stopped):
#   prep_srv.sh OUT c1a1 A spawn-animals=false
#   S=OUT/srv/kubejs/server_scripts
#   cp $INST/tools/soil_yield_probe/sy_probe.js   $S/zz_sy_probe.js    # /syt roll (SQ-SY; now also prints "total N")
#   cp $INST/tools/fungi_probe/zcount.js          $S/zz_count.js       # /zcount (salt cauldron drops)
#   cp $INST/tools/scratch_query/sA_probe.js      $S/zz_sA_probe.js    # /sa offers (SQ-SALT2-07)
#   (zq is copied by prep_srv.sh).
# Config edit before boot (SQ-SALT2-08: an old salt-common.toml carried into creativedelight-common.toml at boot):
#   cd OUT/srv && cp config/salt-common.toml.moved config/salt-common.toml
#   python3 $INST/tools/scratch_query/qrun.py toml config/salt-common.toml Evaporation EvaporationChance 0.5
#   grep -n EvaporationChance config/salt-common.toml      (must print 0.5)
# (0.5 instead of the pack's 0.3 only speeds SQ-SALT2-02's evaporation up; nothing else reads it.)
# Superflat: grass at y -61, air from y -60. Everything sits in x 990..1100, z 990..1100 (forceloaded by C1A-00), the
# Nether cases at 0..15 y 140 (forceloaded in C1A-00). Bots (perfBot, survival, invulnerable): c1rt stands in the work
# area all boot so its chunks get random ticks (no player = no random ticks); c1nb does the same in the Nether; c1sc
# harvests. Every bot gets the starter kit 10 ticks after joining: rows clear it first.
# Order: boot-log rows, setup row (starts the pickling jars: their check row SQ-VTD8-03 runs last, after 6+ min),
# data rows, soil-yield rolls, block rows, jar checks. No /reload in this file.
# Left out (c1_triage.md): client, old-save and recorded rows of chunk 1.
pace 1

## C1A-00 | setup: forceload, clock, bots, start the four pickling jars (not a queue row)
bootexpect Done \(
> forceload add 990 990 1100 1100
> execute in minecraft:the_nether run forceload add 0 0 15 15
> time set noon
> weather clear 1000000
> gamerule doMobSpawning false
> gamerule doDaylightCycle false
sleep 20
> pbot spawn c1rt 1050 -60 1050 minecraft:overworld survival
> execute in minecraft:the_nether run fill 0 140 0 15 140 15 minecraft:stone
> execute in minecraft:the_nether run fill 0 141 0 15 145 15 minecraft:air
> pbot spawn c1nb 8 141 8 minecraft:the_nether survival
sleep 3
> kill @e[type=minecraft:item]
# SQ-VTD8-03 (a): slots 0-4 one cucumber each, slot 5 one salt (5 cucumbers + salt = one pickle batch)
> setblock 1000 -60 1000 vintagedelight:fermenting_jar
> data merge block 1000 -60 1000 {inventory:{Size:10,Items:[{Slot:0b,id:"vintagedelight:cucumber",Count:1b},{Slot:1b,id:"vintagedelight:cucumber",Count:1b},{Slot:2b,id:"vintagedelight:cucumber",Count:1b},{Slot:3b,id:"vintagedelight:cucumber",Count:1b},{Slot:4b,id:"vintagedelight:cucumber",Count:1b},{Slot:5b,id:"vintagedelight:salt_dust",Count:1b}]}}
# (b): 6 cucumbers in 3 slots + salt in slot 3: strict per slot means no batch
> setblock 1000 -60 1003 vintagedelight:fermenting_jar
> data merge block 1000 -60 1003 {inventory:{Size:10,Items:[{Slot:0b,id:"vintagedelight:cucumber",Count:2b},{Slot:1b,id:"vintagedelight:cucumber",Count:2b},{Slot:2b,id:"vintagedelight:cucumber",Count:2b},{Slot:3b,id:"vintagedelight:salt_dust",Count:1b}]}}
# (c): slots 0-4 three cucumbers each, slot 5 three salt: three batches, one item per slot each
> setblock 1000 -60 1006 vintagedelight:fermenting_jar
> data merge block 1000 -60 1006 {inventory:{Size:10,Items:[{Slot:0b,id:"vintagedelight:cucumber",Count:3b},{Slot:1b,id:"vintagedelight:cucumber",Count:3b},{Slot:2b,id:"vintagedelight:cucumber",Count:3b},{Slot:3b,id:"vintagedelight:cucumber",Count:3b},{Slot:4b,id:"vintagedelight:cucumber",Count:3b},{Slot:5b,id:"vintagedelight:salt_dust",Count:3b}]}}
# SQ-STK-06: 3 cucumbers + 2 zucchini + salt
> setblock 1000 -60 1009 vintagedelight:fermenting_jar
> data merge block 1000 -60 1009 {inventory:{Size:10,Items:[{Slot:0b,id:"vintagedelight:cucumber",Count:1b},{Slot:1b,id:"vintagedelight:cucumber",Count:1b},{Slot:2b,id:"vintagedelight:cucumber",Count:1b},{Slot:3b,id:"veggiesdelight:zucchini",Count:1b},{Slot:4b,id:"veggiesdelight:zucchini",Count:1b},{Slot:5b,id:"vintagedelight:salt_dust",Count:1b}]}}
expect ceperfbot|spawned|c1rt
reject (Unknown (item|block|block type|entity)|Incorrect argument for command|Unknown or incomplete command)

## SQ-SALT2-08 | an edited salt-common.toml is carried into creativedelight-common.toml once, renamed .moved, not recreated
bootexpect \[creativedelight\] config/salt-common.toml carried into config/creativedelight-common.toml \(\d+ values\)
bootreject could not carry|could not rename
shell grep -h "salt-common.toml carried" logs/latest.log | cut -c1-300
shell ls config | grep -i "^salt-"; test -f config/salt-common.toml.moved && test ! -f config/salt-common.toml && echo SALT2-08-FILES-OK
shell awk '/^[[:space:]]*\[/{s=$0} s ~ /^[[:space:]]*\[salt\.Evaporation\][[:space:]]*$/ && /EvaporationChance/' config/creativedelight-common.toml
look carried line says 19 values; ls shows salt-client.toml and salt-common.toml.moved only, then SALT2-08-FILES-OK; [salt.Evaporation] EvaporationChance = 0.5. Not covered here (client / no probe): a SaltingFoodValues food value in AppleSkin, and a /reload after editing [salt] applying (CQ / client run)

