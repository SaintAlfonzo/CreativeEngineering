## SQ-PWG-66 | PWG-40 CC: Tweaked peripherals (probe side and a real computer, B17 main-thread setValue), display link to a display board
> zpwg3 place 1100 -60 1660 powergrid:voltage_gauge facing=north
> zpwg3 src 1100 -60 1657 12
> zpwg3 w 1100 -60 1657 0 1100 -60 1660 0
> zpwg3 w 1100 -60 1657 1 1100 -60 1660 1
sleep 2
> zpwg8 periph 1100 -60 1660
> zpwg8 periph 1100 -60 1619
> zpwg3 place 1101 -59 1660 powergrid:redstone_converter facing=north
> zpwg8 periph 1101 -59 1660
> zpwg8 conv 1101 -59 1660 7
sleep 1
> zpwg3 be 1101 -59 1660
> zpwg8 conv 1101 -59 1660 clear
sleep 1
> zpwg3 be 1101 -59 1660
# real computer: startup.lua was copied to pwg10/computercraft/computer/7/ before the boot (pwg10.qb prep)
shell ls -la pwg10/computercraft/computer/7/
> setblock 1101 -60 1660 computercraft:computer_advanced{ComputerId:7,On:1b}
sleep 10
> zpwg3 be 1101 -59 1660
sleep 15
shell cat pwg10/computercraft/computer/7/pwg_out.txt
# display link
> zpwg3 place 1100 -60 1666 create:display_board facing=north
> zpwg3 place 1100 -59 1660 create:display_link facing=up
sleep 1
> zpwg8 dlink 1100 -59 1660 1100 -60 1666 2
> zpwg3 src 1100 -60 1657 -5
sleep 2
> zpwg8 dlink 1100 -59 1660 1100 -60 1666 2
