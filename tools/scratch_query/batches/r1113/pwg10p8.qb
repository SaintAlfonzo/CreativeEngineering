# r1113 Power Grid P8 gate rows (jar jar_archive/pwg_gate/backportedPowerGrid-0.6.2-ce-19.2-10.jar, sha1 c4624ce39cff,
# port phase 8): SQ-PWG-62, -63, -65, -64, -66 (queue run order; CQ-PWG-19 to -21 are client rows, not here).
# Runs on the SAME server as batch 3, after tools/scratch_query/batches/r1113/pwg10.qb and pwg10p6.qb (level pwg10,
# group A superflat, spawn-animals=true, ground Y -61, blocks at Y -60). No boot, no prep of its own: pwg10.qb's header
# lists every prep step (zz_pwg_p8_probe.js, the ponder datapack from the -10 jar, the CC startup program copied to
# OUT/srv/pwg10/computercraft/computer/7/startup.lua). SQ-PWG-62's boot checks (bootexpect / bootreject) read the whole
# log from the boot, so they hold on this third batch too.
# Areas: X 1095 to 1160, Z 1595 to 1680 (SQ-PWG-62 forceload, kept to the end) and the ponder area X 1290 to 1970,
# Z 1290 to 1320 (SQ-PWG-62 only, removed in SETUP10P8). pwg10.qb: X 1095 to 1115, Z 1525 to 1590 (shared chunk row
# Z 1584 to 1599: its last blocks are SQ-PWG-61's sheep at Z 1585, these start at Z 1598); pwg10p6.qb: Z 1385 to 1520.
# Probe goggle reads log a RuntimeDistCleaner ERROR (client class): no blanket ERROR reject.
# waitlog matches anywhere since the row start; real waits are sleeps (20 ticks = 1 s) plus pace (s after each command).
# Batch deviations from the row text: tick waits are sleeps (pace 1 s = 20 ticks after each command, so "wait 10" between
# two commands is already covered); SQ-PWG-63 burnout reads and SQ-PWG-65 reader polls use a short pace for their
# 2 / 8 / 16 tick spacing (approximate); SQ-PWG-65 hopper read is judged by look (its card has the same Data as the first
# card); SQ-PWG-66 computer output is a shell cat (RES/rows/SQ-PWG-66.shell.txt), judged by look.
pace 1

## SQ-PWG-62 | -10 loads (phase 8): registries, 66 recipes, P8 blocks, items, block entities, menu, CRT encasing, CC bridge, module keys, ponder structures 55 + 5
bootexpect Power grid starting, prepare to be electrocuted \(1\.19\.2 port, phase 8\)
bootexpect Done \(
bootreject InvalidInjectionException|InjectionError|Critical injection failure|Mixin apply failed
bootreject ^(?!.*RuntimeDistCleaner).*(/ERROR\]|@Redirect|conflict).*powergrid\.mixins\.json
bootreject (?i)(CCBridge|powergrid\.compat\.cc).*(error|exception)
> forceload add 1095 1595 1160 1680
> forceload add 1290 1290 1970 1320
sleep 12
> zpwg mods powergrid
waitlog \[zpwg\] done 30
> zpwg ns powergrid
waitlog \[zpwg\] ns powergrid total 30
> zpwg3 recipes powergrid
waitlog \[zpwg3\] recipes \d+ 30
> zpwg8 check
waitlog \[zpwg8\] done 30
> datapack list enabled
> zpwg5 nbtall 1300 -60 1300
waitlog \[zpwg5\] nbt summary 300
> zpwg8 nbtall 1100 -60 1675
waitlog \[zpwg8\] nbt summary 120
sleep 1
shell grep -n -E 'powergrid\.mixins\.json|org\.patryk3211\.powergrid\.mixin|Mixin apply failed' logs/latest.log | head -40
shell grep -n -i -E 'computercraft.*(error|exception)|CCBridge|compat\.cc' logs/latest.log | head -20
expect \[zpwg\] mod powergrid 0\.6\.2-ce-19\.2-10
expect \[zpwg\] ns powergrid block: 66\b
expect \[zpwg\] ns powergrid item: 85\b
expect \[zpwg\] ns powergrid entity_type: 4\b
expect \[zpwg\] ns powergrid block_entity_type: 54\b
expect \[zpwg\] ns powergrid menu: 3\b
expect \[zpwg\] ns powergrid recipe_type: 1\b
expect \[zpwg\] ns powergrid recipe_serializer: 1\b
expect \[zpwg3\] recipes 66$
expect recipe powergrid:crafting/alarm_bell type=
expect recipe powergrid:crafting/display_module type=
expect recipe powergrid:crafting/plotter type=
expect recipe powergrid:mechanical_crafting/crt type=
expect recipe powergrid:sequenced_assembly/punch_card type=
reject recipe powergrid:crafting/modular_display type=
reject recipe powergrid:mechanical_crafting/punch_card_reader type=
expect \[zpwg8\] block powergrid:plotter registered=true item=true$
expect \[zpwg8\] block powergrid:alarm_bell registered=true item=true$
expect \[zpwg8\] block powergrid:crt registered=true item=true$
expect \[zpwg8\] block powergrid:andesite_encased_crt registered=true item=false$
expect \[zpwg8\] block powergrid:brass_encased_crt registered=true item=false$
expect \[zpwg8\] block powergrid:punch_card_reader registered=true item=true$
expect \[zpwg8\] block powergrid:modular_display registered=true item=true$
count \[zpwg8\] item powergrid:\S+ registered=true$ == 3
count \[zpwg8\] block entity powergrid:\S+ registered=true$ == 5
expect \[zpwg8\] menu powergrid:punch_card registered=true$
expect \[zpwg8\] crt encased variants=(powergrid:andesite_encased_crt,powergrid:brass_encased_crt|powergrid:brass_encased_crt,powergrid:andesite_encased_crt)$
expect \[zpwg8\] computercraft loaded=true$
expect \[zpwg8\] display module types 0:powergrid\.gui\.modular_display\.0 - 9 \| .* \| 5:powergrid\.gui\.modular_display\.alphabet$
expect file/pwgponder
expect \[zpwg5\] nbt summary files=55 (clean=40 quirk=15|clean=39 quirk=16) bad=0 error=0
reject \[zpwg5\] nbt \S+ (bad|error|missing|unknown)
expect \[zpwg8\] nbt summary files=5 clean=5 bad=0 error=0
count \[zpwg8\] nbt (?!summary)\S+ clean == 5
reject \[zpwg8\] nbt \S+ (bad|error|missing)
reject size=WRONG
reject \[zpwg8\] (block|item|block entity|menu) powergrid:\S+ registered=false
reject \[zpwg8\] computercraft loaded=false
reject InvalidInjectionException|InjectionError|Critical injection failure|Mixin apply failed
reject \[zpwg\w*\] (error|unknown subcommand)
reject ^(?!.*RuntimeDistCleaner).*(Exception|/ERROR\]).*(powergrid|patryk)
look shell output 1: mixin lines name no failure; shell output 2: no CC error or exception line (a CCBridge / provider registration line is fine); zpwg5 summary: the same clean/quirk split as SQ-PWG-47 on -08 (record)

