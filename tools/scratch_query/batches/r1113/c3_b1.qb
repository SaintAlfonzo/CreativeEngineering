shell grep -nE "^\[(surface|shrapnel|vein_undo)\]" config/creativecompat-common.toml
shell diff <(git -C "$INST" show 85104427:config/creativeengineering-common.toml | sed -n '/^\[surface\]/,/^\[vein_undo\]/p' | grep -E "^\s*[A-Za-z_]+ =" | sed 's/^\s*//') <(sed -n '/^\[surface\]/,/^\[vein_undo\]/p' config/creativecompat-common.toml | grep -E "^\s*[A-Za-z_]+ =" | sed 's/^\s*//') | head -20; echo "diff exit ${PIPESTATUS[0]}"
