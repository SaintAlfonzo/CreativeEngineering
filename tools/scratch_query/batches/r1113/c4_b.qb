shell ls r1113c4b/dimensions; echo "level.dat is gzip: $(python3 -c "import gzip,sys;d=gzip.open('r1113c4b/level.dat').read();print(d.count(b'creativeengineering:'), 'creativeengineering refs;', d.count(b'creativeworldgen:'), 'creativeworldgen refs')")"
shell python3 -c "import json,glob,re;s=set();[s.update(re.findall(r'creativeengineering:[a-z_/]+', open(f).read())) for f in glob.glob('kubejs/exported/tags/*_tags.json')];w=[x for x in s if re.search(r'season|crop_season|worldgen|biome|structure|meta/|group/|spawn|bee_nest|wild_flower', x)];print(len(s),'creativeengineering tag ids;', len(w),'worldgen/calendar-like:', sorted(w)[:30])"
