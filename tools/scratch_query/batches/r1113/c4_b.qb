shell cd $INST && for f in kubejs/data/bushierflowers/forge/biome_modifier/*.json; do printf "%s %s\n" "$(grep -c 'forge:none' "$f")" "$f"; done; ls kubejs/data/bushierflowers/forge/biome_modifier | wc -l
