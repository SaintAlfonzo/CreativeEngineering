## SQ-WO-34 | a gift list edit applies without a restart (needs a free inotify instance; see the shell line)
shell echo "inotify instances: $(find /proc/*/fd -lname 'anon_inode:inotify' 2>/dev/null | wc -l) of $(cat /proc/sys/fs/inotify/max_user_instances)"; grep -nE "WatchService|inotify|Too many open files|FileWatcher" logs/debug.log | head -5
shell python3 "$INST/tools/scratch_query/qrun.py" toml config/creativeworldgen-common.toml wise_oak.gifts saplings '["minecraft:oak_sapling"]'
sleep 15
shell echo "reload lines: $(grep -E 'creativeworldgen-common.toml' logs/debug.log | grep -ciE 'changed|reload|notif')"
