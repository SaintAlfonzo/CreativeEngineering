# r1113 Power Grid P3 boot (jar jar_archive/pwg_gate/backportedPowerGrid-0.6.2-ce-19.2-04.jar, sha1 74bb78effab4) with
# the P2 reruns: SQ-PWG-24, -13, -21, -14 (setup for -15), -15, -16, -17, -25 to -34. Group A superflat, level pwg3.
# Prep: COPYDEV=1 PGJAR=$INST/jar_archive/pwg_gate/backportedPowerGrid-0.6.2-ce-19.2-04.jar prep_srv.sh OUT pwg3 A
#   cp pwg_probe.js, pwg_grid_probe.js, pwg_p3_probe.js into OUT/srv/kubejs/server_scripts/ as zz_*.js
# Forceload order matters: SQ-PWG-21 runs before any other area is forced (its resistor chunk must reach level 34).
pace 1

## SQ-PWG-24 | P3 jar loads: registries, wire types, no mixin / data / recipe / client-class errors
bootexpect Power grid starting, prepare to be electrocuted \(1\.19\.2 port, phase 3\)
bootexpect Loaded 5 wire types
bootreject (WARN|ERROR).*(Mixin apply failed|Mixin.*powergrid.*(error|failed)|InvalidInjectionException|InvalidMixinException|powergrid\.mixins\.json)
bootreject ^(?!.*MinecraftServer/\]: Unknown item).*(Couldn't load tag|Failed to load|Couldn't parse|Unknown item|Unknown tag|Error loading registry data).*powergrid
bootreject (ERROR|WARN).*[Ll]oot.*powergrid
bootreject Exception loading blockstate definition.*powergrid
bootreject Parsing error loading recipe powergrid:
bootreject NoClassDefFoundError.*net/minecraft/client
> zpwg mods powergrid
waitlog \[zpwg\] done 30
> zpwg ns powergrid
waitlog \[zpwg\] ns powergrid total 30
expect \[zpwg\] mod powergrid 0\.6\.2-ce-19\.2-04
expect \[zpwg\] ns powergrid block: 36\b
expect \[zpwg\] ns powergrid item: 45\b
expect \[zpwg\] ns powergrid entity_type: 3\b
expect \[zpwg\] ns powergrid block_entity_type: 31\b
expect \[zpwg\] ns powergrid menu: 2\b
expect \[zpwg\] ns powergrid recipe_type: 1\b
expect \[zpwg\] ns powergrid recipe_serializer: 1\b
expect \[zpwg\] ns powergrid fluid: 0\b
> give @p powergrid:battery
sleep 1

## SQ-PWG-13 | powergrid command; performance get before any solve says no measurement yet; reload re-reads wire types
> powergrid debug problems
> powergrid performance get NetSolve
sleep 2
expect Last measurement: no measurement yet
reject An unexpected error occurred
reject Unknown or incomplete command
> reload
waitlog Loaded 5 wire types 120
sleep 8
shell echo "wiretypes $(grep -c 'Loaded 5 wire types' logs/latest.log)"
reject \[(Server thread|Worker-Main-\d+)/ERROR\].*(powergrid|patryk)

## SQ-PWG-21 | H9: 40-block loop across chunks 62 to 65; unload the resistor's chunk; reload it
> forceload add 1000 1070 1050 1075
sleep 4
> zpwgg loop 1000 -60 1070 12 36 powergrid:wire 40
waitlog \[zpwgg\] done 20
sleep 2
> zpwgg read 1000 -60 1070 40
waitlog \[zpwgg\] done 20
> forceload remove 1016 1070 1050 1075
sleep 15
> zpwgg chunk 1043 0 1070
waitlog \[zpwgg\] done 20
> zpwgg chunk 1020 0 1070
waitlog \[zpwgg\] done 20
> zpwgg read 1000 -60 1070 40
waitlog \[zpwgg\] done 20
> zpwgg net 1000 -60 1070
waitlog \[zpwgg\] done 20
> forceload add 1016 1070 1050 1075
sleep 5
> zpwgg read 1000 -60 1070 40
waitlog \[zpwgg\] done 20
> zpwgg wires 1020 -60 1070 30
waitlog \[zpwgg\] done 20
expect \[zpwgg\] chunk 65 \S+ loaded=false
expect \[zpwgg\] read unloaded .*resistor
expect \[zpwgg\] net paused=false
expect \[zpwgg\] wires 5$
reject (Exception|/ERROR\])
look first and last read within 1 %; record chunk 63 blockTicking

## SQ-PWG-SETUP2 | forceload the P2 loop area Z 1000 to 1030 (not a row)
> forceload add 990 990 1060 1030
sleep 4

## SQ-PWG-14r | 10 ohm loop for SQ-PWG-15 (rerun of SQ-PWG-14 on -04)
> zpwgg loop 1000 -60 1000 12 36
waitlog \[zpwgg\] done 20
sleep 2
> zpwgg read 1000 -60 1000
waitlog \[zpwgg\] done 20
expect \[zpwgg\] read V=12(\.0)? I=1\.(19|2)\S* .*wires=5

## SQ-PWG-15 | cut the gauge-to-resistor wire: cut 1, I=0, wires=4
> zpwgg cut 1000 -60 1000
waitlog \[zpwgg\] done 20
sleep 1
> zpwgg read 1000 -60 1000
waitlog \[zpwgg\] done 20
expect \[zpwgg\] cut 1$
expect \[zpwgg\] read V=12(\.0)? I=(0|-?\d(\.\d+)?E-\d+)\S* .*wires=4
reject (Exception|/ERROR\])

## SQ-PWG-16 | 24-block wire R=0.018; drop within 1 % of I x (Rwires + Rgauge)
> zpwgg loop 1000 -60 1010 12 27 powergrid:wire 24
waitlog \[zpwgg\] done 20
sleep 2
> zpwgg read 1000 -60 1010 24
waitlog \[zpwgg\] done 20
> zpwgg wires 1000 -60 1010 30
waitlog \[zpwgg\] done 20
expect R=0\.01799|R=0\.018\b
look read: drop within 1 % of I x (Rwires + Rgauge)

## SQ-PWG-17 | overheat loop without a gauge: about 120 A, a wire overheats and is removed, drops nothing
> zpwgg overheat 1000 -60 1020
waitlog \[zpwgg\] done 20
> zpwgg ohm 1003 -60 1020
waitlog \[zpwgg\] done 20
repeat 10
> zpwgg ohm 1003 -60 1020
> zpwgg wires 1000 -60 1020 8
sleep 1
end
sleep 2
> zpwgg items 1000 -60 1020 8
waitlog \[zpwgg\] done 20
> zpwgg ohm 1003 -60 1020
waitlog \[zpwgg\] done 20
expect overheated=true
expect \[zpwgg\] items 0
reject (Exception|/ERROR\])
look first ohm about 120 A; wire count drops after overheated=true; last ohm I=0 or lower

## SQ-PWG-SETUP3 | forceload the P3 area (not a row)
> forceload add 1090 990 1130 1135
> gamerule doFireTick false
sleep 5

## SQ-PWG-25 | P3 recipes and config keys
> zpwg3 recipes powergrid
waitlog \[zpwg3\] done 20
shell s=pwg3/serverconfig/powergrid-server.toml; grep -n -B2 -A1 -E 'lightningMagnetizationChance|forgeEnergyPerWatt|forgeEnergyPerVolt|feInverterBufferSize|groundingMinimumBlocks|acidBatteryCapacity|transformerMutualInductanceMultiplier' $s; grep -n -A1 -E 'hv_switch|hv_breaker' $s
expect \[zpwg3\] recipes 22$
expect recipe powergrid:magnetization/andesite_alloy type=powergrid:magnetization output=.*magnet
expect recipe powergrid:magnetization/crushed_raw_iron .*iron_nugget
expect recipe powergrid:sequenced_assembly/transformer_core type=create:sequenced_assembly .*transformer_core
expect recipe powergrid:pressing/zinc_sheet
expect recipe powergrid:crafting/thermometer
reject recipe powergrid:sequenced_assembly/battery
look recipes list also has copper_coil, resistive_coil, grounding_rod, device_connector, hv_switch, potato_battery; shell: chance 0.05 with andesite alloy comment, 10.0, 2.0, 20000, 10, 120.0, hv_switch = 2.0, hv_breaker = 2.0

