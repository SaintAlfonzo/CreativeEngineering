shell grep -oE "\[zq\] [a-z_]+:\S*skewer\S* ->" logs/latest.log | awk '{print $2}' | sort -u > c2_bbq2_live.txt; grep -oE "^[a-z_]+:[^,]*skewer[^,]*" $INST/kubejs/exported/recipes/all.csv | sort -u > c2_bbq2_dump.txt; echo "live $(wc -l < c2_bbq2_live.txt) dump $(wc -l < c2_bbq2_dump.txt)"; comm -13 c2_bbq2_live.txt c2_bbq2_dump.txt | head -15
