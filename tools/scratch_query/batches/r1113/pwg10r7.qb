# /reload with the fixed probes first. P8 rows first (SETUP9 in the P7 part kills every non-player entity).
pace 2

## SQ-PWG-R7 | reload with the fixed P7 probe (not a row)
shell cp $INST/tools/scratch_query/pwg_p7_probe.js kubejs/server_scripts/zz_pwg_p7_probe.js; cp $INST/tools/scratch_query/pwg_p8_probe.js kubejs/server_scripts/zz_pwg_p8_probe.js
> reload
sleep 40

