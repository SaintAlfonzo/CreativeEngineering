# r1113 Power Grid P7 gate boot (jar jar_archive/pwg_gate/backportedPowerGrid-0.6.2-ce-19.2-09.jar): SQ-PWG-55, -58,
# -60, -59, -56, -57, -61 (queue run order; CQ rows are client rows, not here). One boot covers all: SQ-PWG-61 needs
# spawn-animals=true, so the whole boot has it (SETUP9 kills the generated animals and stops natural spawning).
# Group A superflat, level pwg9, ground Y -61 (grass), blocks at Y -60.
# Prep:
#   COPYDEV=1 PGJAR=$INST/jar_archive/pwg_gate/backportedPowerGrid-0.6.2-ce-19.2-09.jar prep_srv.sh OUT pwg9 A spawn-animals=true
#   ls OUT/srv/mods | grep -i powergrid        (only backportedPowerGrid-0.6.2-ce-19.2-09.jar; remove -08 and older)
#   for p in pwg_probe pwg_grid_probe pwg_p3_probe pwg_p4_probe pwg_p5_probe pwg_p6_probe pwg_p7_probe; do
#     cp $INST/tools/scratch_query/$p.js OUT/srv/kubejs/server_scripts/zz_$p.js; done
#   ponder datapack from the -09 jar (before boot; as SQ-PWG-46):
#   mkdir -p OUT/pwgp OUT/srv/pwg9/datapacks/pwgponder/data/pwgponder/structures \
#     && unzip -o -q OUT/srv/mods/backportedPowerGrid-0.6.2-ce-19.2-09.jar 'assets/powergrid/ponder/*' -d OUT/pwgp \
#     && cp -r OUT/pwgp/assets/powergrid/ponder/. OUT/srv/pwg9/datapacks/pwgponder/data/pwgponder/structures/ \
#     && printf '{"pack":{"pack_format":10,"description":"PWG ponder structures, scratch only"}}' > OUT/srv/pwg9/datapacks/pwgponder/pack.mcmeta
#   Loading Protection: the damage rows (SQ-PWG-60 zap; -59 slowness) hit villagers, so shorten the protection window:
#   python3 $INST/tools/scratch_query/qrun.py toml OUT/srv/config/loadingprotection-common.toml '"Loading Protection Configuration"' protectionDuration 1
#   (section name checked in config/loadingprotection-common.toml: ["Loading Protection Configuration"], default 150)
#   Difficulty stays peaceful: hostile mobs are removed, villagers, the iron golem and sheep are not.
# Probe goggle reads log a RuntimeDistCleaner ERROR (client class): no blanket ERROR reject.
# waitlog matches anywhere since the row start; real waits are sleeps (20 ticks = 1 s) plus pace (s after each command).
# Batch deviations from the row text: SETUP9 (not a row) kills the animals generated in the forceloaded chunks and sets
# doMobSpawning false, so the baton/zap "nearest living entity" is the summoned target; SQ-PWG-57 picks the worn-tick
# item by capture (the first feitems entry with 0 stored), not by hand; SQ-PWG-61 reuses this boot and SQ-PWG-55's
# forceload (it covers Z 1580 to 1590).
pace 1

## SQ-PWG-55 | -09 loads (phase 7): registries, 61 recipes, P7 glue (movement behaviour, zap source, Capacity, drill mixin), config
bootexpect Power grid starting, prepare to be electrocuted \(1\.19\.2 port, phase 7\)
bootreject InvalidInjectionException|InjectionError|Critical injection failure|Mixin apply failed
bootreject ^(?!.*RuntimeDistCleaner).*(/ERROR\]|@Redirect|conflict).*powergrid\.mixins\.json
bootreject ^(?!.*RuntimeDistCleaner).*(/ERROR\]).*(SheepMixin|PlayerDrillMixin|DrillBreakActionMixin)
> forceload add 1095 1525 1115 1590
sleep 6
> zpwg mods powergrid
waitlog \[zpwg\] done 30
> zpwg ns powergrid
waitlog \[zpwg\] ns powergrid total 30
> zpwg3 recipes powergrid
waitlog \[zpwg3\] recipes \d+ 30
> zpwg6 check
waitlog \[zpwg6\] done 30
> zpwg7 check
waitlog \[zpwg7\] done 30
sleep 1
shell grep -n -E 'powergrid\.mixins\.json|org\.patryk3211\.powergrid\.mixin|Mixin apply failed' logs/latest.log | head -40
expect \[zpwg\] mod powergrid 0\.6\.2-ce-19\.2-09
expect \[zpwg\] ns powergrid block: 59\b
expect \[zpwg\] ns powergrid item: 77\b
expect \[zpwg\] ns powergrid entity_type: 4\b
expect \[zpwg\] ns powergrid block_entity_type: 49\b
expect \[zpwg\] ns powergrid menu: 2\b
expect \[zpwg\] ns powergrid recipe_type: 1\b
expect \[zpwg\] ns powergrid recipe_serializer: 1\b
expect \[zpwg3\] recipes 61$
expect recipe powergrid:crafting/portable_battery type=
expect recipe powergrid:mechanical_crafting/electrobaton type=
expect recipe powergrid:mechanical_crafting/electrozapper type=
expect recipe powergrid:mechanical_crafting/portable_drill type=
expect recipe powergrid:mechanical_crafting/portable_saw type=
reject recipe powergrid:crafting/heating_coil type=
reject recipe powergrid:crafting/light_fixture type=
reject recipe powergrid:crafting/solar_panel_bearing type=
expect \[zpwg6\] fan types .*powergrid:heater_blasting\(150\)
expect \[zpwg6\] fan types .*powergrid:heater_smoking\(250\)
expect \[zpwg6\] fan types .*creativeengineering:dragon_breathing\(500\)
count \[zpwg6\] fan type \S+ registered=true$ == 3
expect \[zpwg6\] contraption type powergrid:solar_panel registered=true
expect \[zpwg6\] solar biome overrides 0$
expect \[zpwg6\] config heaterFanProcessingSpeedMultiplier=0\.75 growthLampRadius=2 growthLampChance=50 electricPumpRange=24 solarPanelMaxSize=25
count \[zpwg6\] mixin target \S+ loaded$ == 6
reject \[zpwg6\] mixin target \S+ error
count \[zpwg7\] item powergrid:\S+ registered=true$ == 6
expect \[zpwg7\] block powergrid:portable_battery registered=true blockEntity=true entity zap_projectile=true
expect \[zpwg7\] lightning_rod movement behaviour=org\.patryk3211\.powergrid\.equipment\.thunder\.LightningRodMovementBehaviour$
expect \[zpwg7\] damage source zap msgId=zap$
expect \[zpwg7\] capacity enchant canEnchant\(portable_battery\)=true max level=3$
expect \[zpwg7\] battery maxCharge level0=20000 level1=40000 level3=80000$
expect \[zpwg7\] fake player PlayerDrillExtensions=true$
expect \[zpwg7\] config drillEnergyPerUse=25 drillMineSpeedBase=6 drillMineSpeedBulk=16 sawEnergyPerUse=100 sawMineSpeed=6 batonEnergy=250 zapperEnergy=500 batteryBase=20000 batteryEnchant=20000$
expect \[zpwg7\] config forgeEnergyPerVolt=2$
reject \[zpwg7\] item powergrid:\S+ registered=false
reject InvalidInjectionException|InjectionError|Critical injection failure|Mixin apply failed
reject \[zpwg\w*\] (error|config error|contraption type error|solar overrides error)
reject ^(?!.*RuntimeDistCleaner).*(Exception|/ERROR\]).*(powergrid|patryk)
look shell output: mixin lines name no failure, none naming SheepMixin, PlayerDrillMixin or DrillBreakActionMixin; movement behaviour none or another class: record which (PowerGridImpl.commonSetup or a pack mod)

## SQ-PWG-SETUP9 | clear the animals generated in the forceloaded chunks; no natural spawning, no fire spread (not a row)
> gamerule doMobSpawning false
> gamerule doFireTick false
> weather clear
> kill @e[type=!minecraft:player]
sleep 2

