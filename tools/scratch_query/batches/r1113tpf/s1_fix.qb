# r1113tpf server tranche s1 (feature_writeup/thirdparty_fixes.md, queue "SQ-TPF"): the commands of every row.
# s1_base.qb (every Debugify fix off: the bug must reproduce) and s1_fix.qb (tranche @s1 on: the bug must be gone) are
# generated from this file by s1_gen.py: lines "!base REGEX-DIRECTIVE" / "!fix REGEX-DIRECTIVE" go only into that file.
# Server needs spawn-animals=true spawn-npcs=true (tpf_srv.sh ... -- spawn-animals=true spawn-npcs=true): with the
# scratch default false, ServerLevel discards every Animal and Npc each tick (cows, wolves, chickens, striders) (r1114).
pace 2

## SQ-TPF-00 | setup and boot: both jars load, no mixin errors from them
bootreject Mixin apply failed|InvalidMixinException|InvalidInjectionException|MixinTransformerError
bootexpect (?i)debugify
bootexpect (?i)packetfixer
> gamerule doFireTick false
> gamerule doMobSpawning false
> gamerule doDaylightCycle false
> time set 6000
> difficulty normal
> forceload add 1000 1000 1599 1015
sleep 8
shell cat config/packetfixer.properties config/debugify.json | tr '\n' ' ' | head -c 600
shell grep -ciE "debugify|packetfixer" logs/latest.log

## SQ-TPF-10 | MC-206922 lightning kills three cows: their drops survive (fixed) or vanish (bug)
# NoAI: a cow that wandered off the strike point survived (r1114)
> summon minecraft:cow 1300 -60 1000 {Health:1f,NoAI:1b,Tags:["l206922"]}
> summon minecraft:cow 1310 -60 1000 {Health:1f,NoAI:1b,Tags:["l206922"]}
> summon minecraft:cow 1320 -60 1000 {Health:1f,NoAI:1b,Tags:["l206922"]}
sleep 2
> summon minecraft:lightning_bolt 1300 -60 1000
> summon minecraft:lightning_bolt 1310 -60 1000
> summon minecraft:lightning_bolt 1320 -60 1000
sleep 5
> execute unless entity @e[tag=l206922]
> execute positioned 1310 -60 1000 if entity @e[type=item,distance=..20]
expect Test passed$
expect Test passed, count: [1-9]

## SQ-TPF-11 | MC-84873 a dead cow with DeathTime 25 is removed (fixed) or stays forever (bug)
# @e and @e[tag=] skip dead entities (EntitySelector adds Entity::isAlive): select the dead cow by UUID (r1114)
> summon minecraft:cow 1400 -60 1000 {DeathTime:25s,Health:0f,UUID:[I;84873,1,2,3]}
sleep 5
> data get entity 00014b89-0000-0001-0000-000200000003 DeathTime
expect No entity was found

## SQ-TPF-12 | MC-200418 a cured baby zombie villager on a chicken: the villager is not left riding (fixed)
> fill 1198 -60 998 1202 -56 1002 minecraft:glass hollow
> summon minecraft:chicken 1200 -59 1000 {Tags:["c200418"],Passengers:[{id:"mca:male_zombie_villager",IsBaby:1b,Age:-24000,ConversionTime:60,PersistenceRequired:1b,ArmorItems:[{},{},{},{id:"minecraft:leather_helmet",Count:1b}]}]}
sleep 8
# MCA (overwriteOriginalZombieVillagers) replaces a summoned minecraft:zombie_villager on join, dropping its vehicle and
# ConversionTime: summon the MCA one, the pack's real path; it converts to mca:male_villager (#zq:villagers) (r1114)
> execute positioned 1200 -59 1000 if entity @e[type=#zq:villagers,distance=..4]
> data get entity @e[tag=c200418,limit=1] Passengers[0].id
expect Test passed, count: 1
expect (?i)no elements matching Passengers

## SQ-TPF-13 | MC-214147 a skeleton in leather armor stays a skeleton in powder snow (fixed) or turns stray (bug)
> fill 1099 -60 999 1101 -57 1001 minecraft:glass
> fill 1100 -59 1000 1100 -58 1000 minecraft:powder_snow
> summon minecraft:skeleton 1100 -59 1000 {PersistenceRequired:1b,ArmorItems:[{},{},{id:"minecraft:leather_chestplate",Count:1b},{id:"minecraft:leather_helmet",Count:1b}]}
sleep 30
> execute positioned 1100 -59 1000 if entity @e[type=stray,distance=..3]
> execute positioned 1100 -59 1000 if entity @e[type=skeleton,distance=..3]
expect Test failed
