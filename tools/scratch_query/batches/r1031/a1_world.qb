> fill -26 -60 -11 -24 -60 -9 minecraft:wheat[age=0]
> item replace entity qa weapon.mainhand with hearthandharvest:watering_can{WaterLevel:16}
> item replace entity qa weapon.offhand with minecraft:air
> tp qa -25 -60 -13
> pbot use qa -25 -60 -10 up
> data get entity qa SelectedItem
> fill -26 -61 -11 -24 -61 -9 minecraft:stone replace minecraft:farmland[moisture=7]
> pbot use qa -25 -60 -10 up
> fill -32 -61 -11 -30 -61 -9 immersive_weathering:mulch_block[moisture=0]
> fill -32 -60 -11 -30 -60 -9 minecraft:wheat[age=0]
> item replace entity qa weapon.mainhand with hearthandharvest:watering_can{WaterLevel:16}
