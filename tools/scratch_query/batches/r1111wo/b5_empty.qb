## SQ-WO-34 | a list edit applies without a restart
shell python3 "$INST/tools/scratch_query/qrun.py" toml config/creativeworldgen-common.toml wise_oak.gifts saplings '["minecraft:oak_sapling"]'
sleep 15
# Forge logs the config watcher at DEBUG: look in debug.log, not latest.log
shell grep -nE "creativeworldgen-common.toml" logs/debug.log | grep -iE "changed|reload|notif" | tail -5; echo "reload lines: $(grep -E 'creativeworldgen-common.toml' logs/debug.log | grep -ciE 'changed|reload|notif')"
