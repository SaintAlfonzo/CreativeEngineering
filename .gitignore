# Allow-list: this folder is a whole ATLauncher instance (~25 GB of saves, backups, mod jars,
# logs, caches). Only the pack's own source is tracked; everything else is ignored by default.
# Third-party jars/packs are NOT committed - pack/manifest.json + pack/MODLIST.md list every
# mod, resource pack and shader pack with its CurseForge/Modrinth source and sha1 instead
# (regenerate with: python3 tools/gen_pack_manifest.py).
/*

# --- repo meta / notes ---
!/.gitignore
!/README.md
!/CLAUDE.md
!/mod_sides.md
!/damage_types_findings.md
!/modlist.ods
!/value.ods
!/dump_loot_tables.sh
!/pack/
# Screenshots of licence / permission replies from mod authors
!/communications/
# Deploy record from tools/build_deploy.py (DEPLOY_LOG.md + history/); the staged payload isn't committed
!/deploy/
/deploy/latest/
!/feature_writeup/
!/todo/
!/tools/
!/.claude/

# --- pack content ---
!/kubejs/
!/config/
!/defaultconfigs/
!/configs_edited/
# In-tree mods (development/patcherMod, development/exposureBackport)
!/development/
# Root Gradle build shared by the in-tree mods
!/settings.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/build-logic/
# Dedicated-server root files shipped by tools/build_deploy.py (LaunchServer scripts, perf/ recording setup)
!/server/

# Hand-made resource pack with no download source (all others are listed in pack/)
!/resourcepacks/
/resourcepacks/*
!/resourcepacks/CE2 Iron Armor Fix.zip

# --- excluded inside tracked folders ---
# JFR recordings/repository if a server was ever run from server/ (the instance's own perf/ is untracked)
/server/perf/recordings/
/server/perf/jfr-repo/
# KubeJS dump output (/dumptags, /dumprecipes, ...) - regenerate in game
/kubejs/exported/
# tools/gen_loot_config.py structure-template scan cache (rebuilt when the jar list changes)
/tools/.cache/
# In-tree mods: build output, dev runs, IDE files, and third-party compile jars (copies of mods/ jars).
# jar_archive/ keeps every built/released jar locally (archiveJar task, tools/build_deploy.py).
/development/*/build/
/development/*/libs/
/development/*/jar_archive/
/development/*/.gradle/
/development/*/run/
/development/*/run-data/
/development/*/.idea/
/development/*/tools/__pycache__/
# Bundle members, one level deeper (Creative Delight, Creative Brewing), and the build-time upstream jars of CD's
# repacks (sha1-pinned in each member's gradle.properties; copied from the mods' releases, never committed)
/development/*/members/*/build/
/development/*/members/*/jar_archive/
/development/*/members/*/.gradle/
/development/*/members/*/run/
/development/*/members/*/run-data/
/development/*/members/*/libs/
/development/*/members/*/tools/__pycache__/
/development/creativeDelight/upstream/
# root Gradle build output
/.gradle/
/build-logic/build/
/build-logic/.gradle/
# WorldEdit runtime cache / per-player sessions
/config/worldedit/.archive-unpack/
/config/worldedit/sessions/
# Player changelog read marker (patcherMod changelog/ChangelogStore): each player's own, never shipped
/config/creativecommon/changelog_seen.txt
# Claude Code per-machine settings
/.claude/settings.local.json

__pycache__/
*.pyc
*.class
/tools/creative_delight_test/move_diff_snapshot.json
/tools/creative_delight_test/move_diff_dump_snapshot.json
/tools/.nested_jars/
